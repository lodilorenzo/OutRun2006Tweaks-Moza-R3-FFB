+#define UNUSED_METHOD(name, args) HRESULT STDMETHODCALLTYPE name args override { assert(!"Unexpected COM call: " #name); return E_NOTIMPL; }
+#define UNKNOWN_METHODS \
+    UNUSED_METHOD(QueryInterface, (REFIID, LPVOID*)) \
