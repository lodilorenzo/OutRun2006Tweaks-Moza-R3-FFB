+struct Effect : IDirectInputEffect
+{
+    Trace& t;
+    DWORD reportedDuration = NativeFfb::LeaseMs * 1000;
+    uint64_t now = 0, expires = 0;
+    LONG magnitude = 0;
+    explicit Effect(Trace& trace) : t(trace) {}
+    UNKNOWN_METHODS
+    ULONG STDMETHODCALLTYPE Release() override { t.hit("effect.release"); return 0; }
+    UNUSED_METHOD(Initialize, (HINSTANCE, DWORD, REFGUID))
+    UNUSED_METHOD(GetEffectGuid, (LPGUID))
+    HRESULT STDMETHODCALLTYPE GetParameters(LPDIEFFECT desc, DWORD flags) override
+    {
+        assert(flags == DIEP_DURATION);
+        desc->dwDuration = reportedDuration;
+        return t.hit("duration");
+    }
+    HRESULT STDMETHODCALLTYPE SetParameters(LPCDIEFFECT desc, DWORD flags) override
+    {
+        assert(flags == (DIEP_TYPESPECIFICPARAMS | DIEP_START));
+        assert(desc->cbTypeSpecificParams == sizeof(DICONSTANTFORCE));
+        const HRESULT hr = t.hit("submit");
+        if (SUCCEEDED(hr))
+        {
+            magnitude = static_cast<DICONSTANTFORCE*>(desc->lpvTypeSpecificParams)->lMagnitude;
+            assert(std::abs(magnitude) <= NativeFfb::DeviceMaxForce);
+            expires = now + NativeFfb::LeaseMs;
+        }
+        return hr;
+    }
+    UNUSED_METHOD(Start, (DWORD, DWORD))
+    HRESULT STDMETHODCALLTYPE Stop() override
+    {
+        const auto hr = t.hit("stop");
+        if (SUCCEEDED(hr)) magnitude = 0;
+        return hr;
+    }
+    UNUSED_METHOD(GetEffectStatus, (LPDWORD))
+    UNUSED_METHOD(Download, ())
+    UNUSED_METHOD(Unload, ())
+    UNUSED_METHOD(Escape, (LPDIEFFESCAPE))
+    LONG output() const { return now < expires ? magnitude : 0; }
+};
