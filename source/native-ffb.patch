+namespace NativeFfb
+{
+constexpr DWORD LeaseMs = 100;
+constexpr LONG MaxForce = DI_FFNOMINALMAX; // 100% combined DirectInput output, NOT measured torque.
+constexpr float MaxStrength = float(MaxForce) / DI_FFNOMINALMAX;
+// v0.2.0 retains the operator-tested 50% cap, regardless of INI/overlay values.
+constexpr LONG DeviceMaxForce = 5000;
+inline LONG LimitOutput(int64_t magnitude)
+{
+    return LONG(std::clamp<int64_t>(magnitude, -DeviceMaxForce, DeviceMaxForce));
+}
+
+inline bool Fresh(uint64_t now, uint64_t sample)
+{
+    return now >= sample && now - sample < LeaseMs;
+}
+
+inline bool Allowed(bool enabled, bool racing, bool focused, bool blocked,
+    bool connected, uint64_t now, uint64_t inputTick, uint64_t carTick)
+{
+    return enabled && racing && focused && !blocked && connected &&
+        Fresh(now, inputTick) && Fresh(now, carTick);
+}
+
+// Physical SDL steering only; no guessed car-physics offsets.
+struct CentreForce
+{
+    static constexpr float MaxStrength = NativeFfb::MaxStrength; // Actual 0..1 output, not normalized to the old 10% cap.
+    float level = 0;
+    uint64_t tick = 0;
+    bool started = false;
+
+    void reset() { level = 0; tick = 0; started = false; }
+
+    LONG step(float steer, float strength, float centre, float deadzone, bool invert, uint64_t now)
+    {
+        if (!std::isfinite(steer) || std::abs(steer) > 1 || !std::isfinite(strength) || strength <= 0 ||
+            !std::isfinite(centre) || std::abs(centre) > 0.25f ||
+            !std::isfinite(deadzone) || deadzone < 0 || deadzone > 0.25f)
+        {
+            reset();
+            return 0;
+        }
+        if (!started || !Fresh(now, tick))
+        {
+            reset();
+            started = true;
+            tick = now;
+            return 0; // First sample after every stop/stall starts at zero.
+        }
+        const float dt = float((std::min)(now - tick, uint64_t(20))) / 1000.0f;
+        tick = now;
+        const float offset = std::clamp(steer - centre, -1.0f, 1.0f);
+        const float displacement = (std::max)(0.0f, std::abs(offset) - deadzone) / (1.0f - deadzone);
+        const float target = -std::copysign(displacement, offset) * (invert ? -1.0f : 1.0f) *
+            std::clamp(strength, 0.0f, MaxStrength) * DI_FFNOMINALMAX;
+        // Never retain a pull across centre/sign reversal or after lowering the cap.
+        if (target == 0 || level * target < 0)
+            level = 0;
+        const float slew = 1000.0f * dt; // Unchanged slew: at least 10 s from zero to the 100% ceiling.
+        level += std::clamp(target - level, -slew, slew);
+        const float cap = std::clamp(strength, 0.0f, MaxStrength) * DI_FFNOMINALMAX;
+        level = std::clamp(level, -cap, cap);
+        return LONG(level);
+    }
+};
+
+// One smooth positive/negative cycle on an observed adjacent gear change.
+// First sample, invalid gear, pause/reset and stale data never manufacture a shift.
+struct ShiftJolt
+{
+    static constexpr uint64_t DurationMs = 160;
+    static constexpr uint64_t CooldownMs = 300;
+    static constexpr float MaxStrength = NativeFfb::MaxStrength;
+    uint32_t previousGear = 0;
+    uint64_t tick = 0, pulseTick = 0;
+    bool pulsing = false, hasPulse = false;
+
+    void reset() { *this = {}; }
+
+    LONG step(uint32_t gear, float strength, uint64_t now)
+    {
+        if (gear < 1 || gear > 6 || !std::isfinite(strength) || strength <= 0)
+        {
+            reset();
+            return 0;
+        }
+        if (!previousGear || !Fresh(now, tick))
+        {
+            reset();
+            previousGear = gear;
+            tick = now;
+            return 0;
+        }
+        tick = now;
+        if (pulsing && now - pulseTick >= DurationMs) pulsing = false;
+        const int delta = int(gear) - int(previousGear);
+        previousGear = gear;
+        if (std::abs(delta) > 1)
+        {
+            pulsing = false; // Do not interpret a reset/multi-gear jump as an impact.
+            return 0;
+        }
+        if (delta && !pulsing && (!hasPulse || now - pulseTick >= CooldownMs))
+        {
+            pulseTick = now;
+            pulsing = hasPulse = true;
+        }
+        if (!pulsing) return 0;
+        // ponytail: game-tick sine, not hardware periodic output; upgrade only if low-FPS aliasing matters.
+        const double phase = 2 * std::numbers::pi * double(now - pulseTick) / double(DurationMs);
+        return LONG(std::sin(phase) * std::clamp(strength, 0.0f, MaxStrength) * DI_FFNOMINALMAX);
+    }
+};
+
+// Conservative onset signature from the labelled PC capture, not a wall-side decoder.
+struct CollisionJolt
+{
+    static constexpr uint64_t DurationMs = 120;
+    static constexpr uint64_t CooldownMs = 500;
+    static constexpr float MaxStrength = NativeFfb::MaxStrength;
+    uint64_t tick = 0, pulseTick = 0;
+    bool started = false, previousOnset = false, pulsing = false, hasPulse = false, triggered = false;
+
+    void reset() { *this = {}; }
+
+    LONG step(uint32_t flags4, uint32_t flags8, float speed, float strength, uint64_t now)
+    {
+        triggered = false;
+        if (!std::isfinite(speed) || speed <= 0.001f || speed > 10 ||
+            !std::isfinite(strength) || strength <= 0)
+        {
+            reset();
+            return 0;
+        }
+        // ponytail: require the captured 0x20000 + 0x100 onset pair; broaden only with additional labelled contact evidence.
+        const bool onset = (flags4 & 0x20000) && (flags8 & 0x100);
+        if (!started || !Fresh(now, tick) || now - tick > 40)
+        {
+            reset();
+            started = true;
+            previousOnset = onset;
+            tick = now;
+            return 0; // Never kick on attach, resume, invalid data or undersampled recovery.
+        }
+        tick = now;
+        const bool edge = onset && !previousOnset;
+        previousOnset = onset;
+        if (pulsing && now - pulseTick >= DurationMs) pulsing = false;
+        if (edge && !pulsing && (!hasPulse || now - pulseTick >= CooldownMs))
+        {
+            pulseTick = now;
+            pulsing = hasPulse = triggered = true;
+        }
+        if (!pulsing) return 0;
+        // Alternating pulse, not an invented push away from a guessed wall side.
+        const double phase = 2 * std::numbers::pi * double(now - pulseTick) / double(DurationMs);
+        return LONG(std::sin(phase) * std::clamp(strength, 0.0f, MaxStrength) * DI_FFNOMINALMAX);
+    }
+};
+
+// Reuse the Xbox surface lookup supplied by the game integration; the callback
+// also lets the hardware-free check exercise all four contact masks.
+inline float SurfaceRoughness(const std::array<uint32_t, 4>& masks, int loadType,
+    double (__cdecl* lookup)(unsigned int, int, DWORD*), DWORD* waterResult = nullptr)
+{
+    if (waterResult) *waterResult = 0; // Unknown contact never exposes a partial water result.
+    if (!lookup) return -1;
+    float roughness = -1; // No valid contact is not a smooth-road sample.
+    DWORD water = 0;
+    for (const auto mask : masks)
+    {
+        if (!mask) continue;
+        // ponytail: only single-bit contact IDs; validate composite IDs from logs before supporting them.
+        if (mask > 0x800000 || !std::has_single_bit(mask)) return -1;
+        const float value = float(lookup(mask, loadType, &water));
+        if (!std::isfinite(value) || value < 0 || value > 1) return -1;
+        roughness = (std::max)(roughness, value);
+    }
+    if (waterResult && roughness >= 0) *waterResult = water;
+    return roughness;
+}
