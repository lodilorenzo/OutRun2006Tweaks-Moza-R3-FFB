diff --git a/src/contact_models.hpp b/src/contact_models.hpp
new file mode 100644
index 0000000..4825f2d
--- /dev/null
+++ b/src/contact_models.hpp
@@ -0,0 +1,143 @@
+#pragma once
+#include "native_ffb.hpp"
+
+// EXPERIMENTAL CONTACT TRIAL. Called by the existing player hook before Xbox
+// vibration mutates flags8. Flags are sampled evidence, not verified solidity.
+// Models make no device calls, actor-pointer reads or directional assumptions.
+namespace NativeFfb::Experimental
+{
+constexpr uint32_t WallBit = 0x20000, TrafficBit = 0x10000;
+enum class Contact { Unknown, Absent, Present };
+
+// Same texture for barrier and experimental traffic contact; callers keep
+// independent instances. No periodic impact retriggering or phase restart on edges.
+struct ContactTexture
+{
+    static constexpr double FrequencyHz = 8;
+    static constexpr float AttackMs = 60;
+    uint64_t tick = 0;
+    double phase = 0;
+    float amplitude = 0;
+    bool started = false, previousContact = false;
+
+    void reset() { *this = {}; }
+
+    LONG step(Contact contact, float speed, float strength, float fullSpeed, uint64_t now)
+    {
+        if ((contact != Contact::Absent && contact != Contact::Present) ||
+            !std::isfinite(speed) || speed <= 0.001f || speed > 10 ||
+            !std::isfinite(strength) || strength <= 0 ||
+            !std::isfinite(fullSpeed) || fullSpeed < 0.05f || fullSpeed > 10)
+        {
+            reset();
+            return 0;
+        }
+        if (started && now == tick) { reset(); return 0; } // Ambiguous duplicate: invalidate history.
+        if (!started || !Fresh(now, tick) || now - tick > 40)
+        {
+            reset();
+            started = true;
+            tick = now;
+            previousContact = contact == Contact::Present;
+            return 0; // Attach/resume/gap never starts with a nonzero command.
+        }
+        const auto dt = now - tick;
+        tick = now;
+        phase = std::fmod(phase + FrequencyHz * double(dt) / 1000.0, 1.0);
+        const bool present = contact == Contact::Present;
+        // ponytail: zero dropout tolerance and immediate release; this can sound
+        // choppy on flickering contacts. Add a bounded fade only with release evidence.
+        if (!present || !previousContact) amplitude = 0;
+        else
+        {
+            const float target = std::clamp(strength, 0.0f, MaxStrength) * DI_FFNOMINALMAX *
+                std::clamp(speed / fullSpeed, 0.0f, 1.0f);
+            amplitude = (std::min)(target, amplitude + target * float(dt) / AttackMs);
+        }
+        previousContact = present;
+        return LONG(std::sin(2 * std::numbers::pi * phase) * amplitude);
+    }
+};
+
+// Reuse the existing 120ms pulse/500ms edge cooldown, not a second waveform.
+// The flag adapter represents an experimental traffic hypothesis; it does not turn
+// a traffic flag into evidence of a barrier hit. Never AND with lagging flags8.
+struct TrafficJolt
+{
+    CollisionJolt pulse;
+    void reset() { pulse.reset(); }
+    LONG step(uint32_t flags4, float speed, float strength, uint64_t now)
+    {
+        if (pulse.started && now == pulse.tick) { reset(); return 0; }
+        return pulse.step((flags4 & TrafficBit) ? WallBit : 0, 0x100, speed, strength, now);
+    }
+};
+
+struct ContactSettings
+{
+    float barrierStrength = 0, barrierScrape = 0, trafficStrength = 0, trafficScrape = 0;
+    float fullSpeed = 1; // Reuses NativeFfbRoadFullSpeed raw calibration, not km/h.
+};
+
+struct ContactOutput
+{
+    LONG barrier = 0, traffic = 0, barrierScrape = 0, trafficScrape = 0;
+    bool barrierTriggered = false, trafficTriggered = false;
+    bool barrierSuppressed = false, trafficSuppressed = false;
+
+    // Same signed-wide sum and final cap as the baseline, exactly one clamp.
+    // Centre is already polarity-correct; invert only the accent terms here.
+    int64_t sum(LONG centre, LONG shift, LONG road, bool invert = false) const
+    {
+        const int64_t accents = int64_t(shift) + road + barrier + traffic + barrierScrape + trafficScrape;
+        return int64_t(centre) + (invert ? -accents : accents);
+    }
+    LONG mix(LONG centre, LONG shift, LONG road, bool invert = false) const
+    {
+        return LONG(std::clamp<int64_t>(sum(centre, shift, road, invert), -MaxForce, MaxForce));
+    }
+};
+
+struct ContactModels
+{
+    CollisionJolt barrier;
+    TrafficJolt traffic;
+    ContactTexture barrierTexture, trafficTexture;
+    void reset() { barrier.reset(); traffic.reset(); barrierTexture.reset(); trafficTexture.reset(); }
+
+    // Caller must reset on player/stage replacement and every lifecycle stop.
+    // valid=false is an immediate safety/unknown-data stop, never a cosmetic fade.
+    ContactOutput step(uint32_t flags4, uint32_t flags8, float speed,
+        const ContactSettings& settings, uint64_t now, bool valid = true)
+    {
+        if (!valid) { reset(); return {}; }
+        ContactOutput out;
+        out.barrier = barrier.step(flags4, flags8, speed, settings.barrierStrength, now);
+        out.traffic = traffic.step(flags4, speed, settings.trafficStrength, now);
+        if (barrier.pulsing && traffic.pulse.pulsing)
+        {
+            // First active envelope wins; simultaneous starts prefer the legacy
+            // barrier. Consume suppressed edges/cooldowns, never queue or extend.
+            if (barrier.triggered && !traffic.pulse.triggered)
+            {
+                out.barrierSuppressed = true;
+                out.barrier = 0;
+                barrier.pulsing = barrier.triggered = false;
+            }
+            else
+            {
+                out.trafficSuppressed = true;
+                out.traffic = 0;
+                traffic.pulse.pulsing = traffic.pulse.triggered = false;
+            }
+        }
+        out.barrierTriggered = barrier.triggered;
+        out.trafficTriggered = traffic.pulse.triggered;
+        out.barrierScrape = barrierTexture.step((flags4 & WallBit) ? Contact::Present : Contact::Absent,
+            speed, settings.barrierScrape, settings.fullSpeed, now);
+        out.trafficScrape = trafficTexture.step((flags4 & TrafficBit) ? Contact::Present : Contact::Absent,
+            speed, settings.trafficScrape, settings.fullSpeed, now);
+        return out;
+    }
+};
+}
