+// Synthetic model tests only: no game/device calls or observed private captures.
+#include "../src/native_ffb.hpp"
+#include "legacy_road.hpp"
+#include <cassert>
+#include <iostream>
+#include <limits>
+using namespace NativeFfb;
+
+int main()
+{
+    static_assert(sizeof(void*) == 4 && DeviceMaxForce == 5000 && LeaseMs == 100);
+    const float nan = std::numeric_limits<float>::quiet_NaN(), inf = std::numeric_limits<float>::infinity();
+    ExperimentalDriftEstimate d;
+    auto sample = [&](int raw, uint64_t t) { return d.step(raw, 0, 0, 1, true, t); };
+    auto prime = [&] {
+        d.reset();
+        for (uint64_t t = 0; t <= 240; t += 10) sample(0, t);
+        assert(d.status == DriftStatus::Grip);
+    };
+    for (int raw : {-32768, -2000, 2000, 32767})
+    {
+        prime();
+        for (uint64_t t = 250; t < 330; t += 10) assert(sample(raw, t) == DriftStatus::Grip);
+        assert(sample(raw, 330) == DriftStatus::Drift);
+        assert(sample(1001, 340) == DriftStatus::Drift);
+        assert(sample(1000, 350) == DriftStatus::Grip);
+    }
+    prime(); sample(3000, 250);
+    for (int i = 0; i < 100; ++i) assert(sample(3000, 250) == DriftStatus::Grip);
+    for (uint64_t t = 260; t <= 330; t += 10) sample(3000, t);
+    assert(sample(3000, 370) == DriftStatus::Drift); // Exactly 40ms.
+    for (uint64_t t : {369ull, 411ull, 469ull, 470ull})
+    { auto copy = d; assert(copy.step(3000, 0, 0, 1, true, t) == DriftStatus::Unknown); }
+    for (uint32_t flags : {0x10000u, 0x20000u, 0x30000u})
+    {
+        assert(d.step(3000, flags, 0, 1, true, d.tick) == DriftStatus::Unknown);
+        for (uint64_t t = 400; t <= 1000; t += 10) assert(sample(3000, t) == DriftStatus::Unknown);
+        for (uint64_t t = 1010; t <= 1240; t += 10) sample(0, t);
+        assert(d.status == DriftStatus::Grip);
+    }
+    prime(); assert(d.step(3000, 0, 0x40, 1, true, 250) == DriftStatus::Unknown);
+    for (float speed : {0.f, .099f, 11.f, nan, inf})
+    { prime(); assert(d.step(3000, 0, 0, speed, true, 250) == DriftStatus::Unknown && !d.started); }
+    for (int raw : {-32769, 32768}) { prime(); assert(sample(raw, 250) == DriftStatus::Unknown); }
+    prime(); assert(d.step(3000, 0, 0, 1, false, 250) == DriftStatus::Unknown);
+    prime(); assert(d.step(3000, 0, 0, 1, true, 250, 1000, 1000) == DriftStatus::Unknown);
+    prime(); assert(d.step(3000, 0, 0, 1, true, 250, 2000, -1) == DriftStatus::Unknown);
+    for (float floor : {0.f, 11.f, nan, inf})
+    { prime(); assert(d.step(3000, 0, 0, 1, true, 250, 2000, 1000, floor) == DriftStatus::Unknown); }
+    d.reset();
+    for (uint64_t t = 0; t < 5000; t += 10) assert(sample(8000, t) == DriftStatus::Unknown);
+
+    // A real percentage, independent of road endpoints, speed, surface and cadence.
+    for (float damping : {0.f, 20.f, 50.f, 100.f})
+    for (auto endpoints : {std::array{.02f, .08f}, std::array{.08f, .02f}, std::array{.1f, .3f}, std::array{0.f, .08f}})
+    for (float surface : {0.f, .45f, .9f, 1.f})
+    for (float speed : {.2f, 1.f, 2.f})
+    for (uint64_t cadence : {10ull, 17ull, 33ull, 40ull})
+    {
+        RoadRumble road; LegacyRoadRumble normal;
+        uint64_t now = 0;
+        auto step = [&](DriftStatus status) {
+            normal.step(speed, surface, endpoints[0], endpoints[1], 1, now);
+            const auto output = road.step(speed, surface, endpoints[0], endpoints[1], 1, now, status, damping);
+            assert(road.amplitude <= normal.amplitude + .001f);
+            assert(std::abs(LimitOutput(int64_t(output) + 1000)) <= 5000);
+            now += cadence;
+        };
+        for (int i = 0; i < 400; ++i) step(DriftStatus::Grip);
+        assert(std::abs(road.amplitude - normal.amplitude) < .001f);
+        for (int i = 0; i < 100; ++i) step(DriftStatus::Drift);
+        assert(std::abs(road.amplitude - normal.amplitude * (1 - damping / 100)) < .001f);
+        if (damping == 100) assert(road.amplitude == 0); // Only road, never master/centring.
+        const auto phase = road.phase;
+        const auto tick = road.tick;
+        road.step(speed, surface, endpoints[0], endpoints[1], 1, tick, DriftStatus::Drift, damping);
+        assert(road.phase == phase); // Duplicate timestamp cannot advance the waveform.
+        for (int i = 0; i < 100; ++i) step(DriftStatus::Grip);
+        assert(std::abs(road.amplitude - normal.amplitude) < .001f);
+        for (int i = 0; i < 100; ++i) step(DriftStatus::Drift);
+        road.driftAmount = 0; // The actual hook clears unknown/contact immediately.
+        for (int i = 0; i < 100; ++i) step(DriftStatus::Unknown);
+        assert(std::abs(road.amplitude - normal.amplitude) < .001f);
+        assert(road.step(speed, surface, endpoints[0], endpoints[1], 1, now + 100, DriftStatus::Drift, damping) == 0);
+        assert(road.amplitude == 0 && road.driftAmount == 0);
+    }
+    for (auto config : {std::array{0.f, 8.f}, std::array{-1.f, 8.f}, std::array{101.f, 8.f},
+        std::array{nan, 8.f}, std::array{inf, 8.f}, std::array{20.f, nan}, std::array{20.f, inf},
+        std::array{20.f, 5.9f}, std::array{20.f, 10.1f}})
+    {
+        RoadRumble road; LegacyRoadRumble normal;
+        uint64_t now = 0; uint32_t rng = 11;
+        for (int i = 0; i < 5000; ++i)
+        {
+            rng = rng * 1664525u + 1013904223u;
+            now += std::array<uint64_t, 7>{0, 16, 17, 33, 40, 41, 100}[rng % 7];
+            if (i % 67 == 0) { road.reset(); normal.reset(); }
+            const float surface = rng & 1 ? .9f : 0.f;
+            assert(road.step(1, surface, .02f, .08f, 1, now, DriftStatus::Drift, config[0], config[1]) == normal.step(1, surface, .02f, .08f, 1, now));
+            assert(road.phase == normal.phase && road.amplitude == normal.amplitude && road.driftAmount == 0);
+        }
+    }
+    RoadRumble road;
+    for (uint64_t now = 0; now <= 300; now += 10)
+    {
+        const auto previous = road.phase;
+        const bool started = road.started;
+        road.step(1, .9f, .02f, .08f, 1, now, DriftStatus::Drift, 20);
+        if (started) assert(std::abs(road.phase - std::fmod(previous + std::lerp(10.0, 8.0, double(road.driftAmount)) * (10.f / 1000.f), 1.0)) < 1e-12);
+        assert(std::abs(road.driftAmount - (std::min)(1.f, float(now) / 100)) < .00001f);
+    }
+    assert(road.step(1, .9f, 0, 0, 1, 310, DriftStatus::Drift, 20) == 0 && !road.started);
+    std::cout << "PASS: drift detector gates, 0/20/50/100 percent damping, endpoint independence, neutral legacy equivalence, phase/clock/contact/recovery checks; synthetic only\n";
+}
diff --git a/tests/legacy_road.hpp b/tests/legacy_road.hpp
new file mode 100644
index 0000000..9f8abfb
--- /dev/null
+++ b/tests/legacy_road.hpp
@@ -0,0 +1,51 @@
+// Frozen pre-drift road model for independent equivalence checks.
+namespace NativeFfb {
+struct LegacyRoadRumble
+{
+    uint64_t tick = 0;
+    double phase = 0;
+    float amplitude = 0;
+    bool started = false;
+
+    void reset() { *this = {}; }
+
+    LONG step(float speed, float roughness, float roadStrength, float offroadStrength,
+        float fullSpeed, uint64_t now)
+    {
+        if (!std::isfinite(speed) || speed <= 0.001f || speed > 10 ||
+            !std::isfinite(roughness) || roughness < 0 || roughness > 1 ||
+            !std::isfinite(roadStrength) || roadStrength < 0 ||
+            !std::isfinite(offroadStrength) || offroadStrength < 0 ||
+            (roadStrength == 0 && offroadStrength == 0) ||
+            !std::isfinite(fullSpeed) || fullSpeed < 0.05f || fullSpeed > 10)
+        {
+            reset();
+            return 0;
+        }
+        // Suppress undersampled continuous vibration rather than aliasing it
+        // into a one-sided pull. First sample after any gap starts at zero.
+        if (!started || !Fresh(now, tick) || now - tick > 40)
+        {
+            reset();
+            started = true;
+            tick = now;
+            return 0;
+        }
+        const float dt = float(now - tick) / 1000.0f;
+        tick = now;
+        const float speedGain = std::clamp(speed / fullSpeed, 0.0f, 1.0f);
+        const float surfaceGain = std::clamp(roughness / 0.9f, 0.0f, 1.0f);
+        const float strength = std::lerp(std::clamp(roadStrength, 0.0f, MaxStrength),
+            std::clamp(offroadStrength, 0.0f, MaxStrength), surfaceGain);
+        const float target = strength * speedGain * DI_FFNOMINALMAX;
+        const float slew = 5000.0f * (std::min)(dt, 0.02f);
+        amplitude += std::clamp(target - amplitude, -slew, slew);
+        // Lowering a configured strength never leaves a stronger residual.
+        amplitude = (std::min)(amplitude, strength * DI_FFNOMINALMAX);
+        // ponytail: 6-10 Hz software rumble, >=25 Hz updates required; use hardware periodics for higher frequencies/low FPS.
+        phase = std::fmod(phase + (6.0 + 4.0 * speedGain) * dt, 1.0);
+        return LONG(std::sin(2 * std::numbers::pi * phase) * amplitude);
+    }
+};
+
+}
