diff --git a/tests/combined_effects_test.cpp b/tests/combined_effects_test.cpp
new file mode 100644
index 0000000..6435b77
--- /dev/null
+++ b/tests/combined_effects_test.cpp
@@ -0,0 +1,80 @@
+// Hardware-free all-implemented-effects mix, including synthetic drift damping.
+#include "../src/contact_models.hpp"
+#include "../src/native_rpm_leds.hpp"
+#include <cassert>
+#include <iostream>
+using namespace NativeFfb;
+using namespace NativeFfb::Experimental;
+
+int main()
+{
+    static_assert(sizeof(void*) == 4 && DeviceMaxForce == 5000 && LeaseMs == 100);
+    unsigned totalClipped = 0;
+    for (uint64_t cadence : {16ull, 17ull, 33ull, 40ull})
+    for (bool invert : {false, true})
+    for (float steering : {-1.f, 1.f})
+    {
+        CentreForce centre;
+        ShiftJolt shift;
+        RoadRumble road;
+        ContactModels contacts;
+        NativeRpmLeds::Mailbox leds;
+        std::array<LONG, 7> lo{}, hi{};
+        unsigned clipped = 0, overlapping = 0;
+        const ContactSettings settings{.5f, .05f, .5f, .05f, 1};
+        for (uint64_t elapsed = 0; elapsed < 6000; elapsed += cadence)
+        {
+            const auto now = 1000 + elapsed;
+            const auto phase = elapsed % 2000;
+            const uint32_t flags = (phase >= 200 && phase < 600 ? TrafficBit : 0) |
+                (phase >= 1000 && phase < 1400 ? WallBit : 0) |
+                (phase >= 1600 && phase < 1800 ? WallBit | TrafficBit : 0);
+            const auto c = centre.step(steering, .1f, 0, .02f, invert, now);
+            const auto s = shift.step(2 + uint32_t((elapsed + 200) / 400 % 2), .3f, now);
+            const auto drift = flags ? DriftStatus::Unknown :
+                phase >= 650 && phase < 950 ? DriftStatus::Drift : DriftStatus::Grip;
+            if (drift == DriftStatus::Unknown) road.driftAmount = 0;
+            const auto r = road.step(1, elapsed / 1000 % 2 ? .9f : 0.f, .02f, .08f, 1, now, drift, 20);
+            if (flags) assert(road.driftAmount == 0);
+            const auto out = contacts.step(flags, 0x100, 1, settings, now);
+            const std::array<LONG, 7> values{c, s, r, out.barrier, out.traffic, out.barrierScrape, out.trafficScrape};
+            const std::array<LONG, 7> limits{1000, 3000, 800, 5000, 5000, 500, 500};
+            for (size_t i = 0; i < values.size(); ++i)
+            {
+                assert(std::abs(values[i]) <= limits[i]);
+                lo[i] = (std::min)(lo[i], values[i]); hi[i] = (std::max)(hi[i], values[i]);
+            }
+            assert(!out.barrier || !out.traffic); // One impact envelope, no stacking.
+            assert((flags & WallBit) || out.barrierScrape == 0);
+            assert((flags & TrafficBit) || out.trafficScrape == 0);
+            const int64_t accents = int64_t(s) + r + out.barrier + out.traffic + out.barrierScrape + out.trafficScrape;
+            const auto raw = out.sum(c, s, r, invert);
+            assert(raw == c + (invert ? -accents : accents));
+            const auto force = LimitOutput(raw);
+            assert(force == (raw < -5000 ? -5000 : raw > 5000 ? 5000 : raw));
+            clipped += raw != force;
+            overlapping += c != 0 && s != 0 && r != 0 && (out.barrier != 0 || out.traffic != 0);
+            // Numeric LED publication remains independent of the force mixer.
+            const auto mask = NativeRpmLeds::Mask(6000, 4000, 8000);
+            assert(mask != 0);
+            leds.publish(mask, now);
+            assert(leds.read(now, true) == mask && leds.read(now, false) == 0);
+        }
+        for (size_t i = 1; i < lo.size(); ++i) assert(lo[i] < 0 && hi[i] > 0);
+        assert(overlapping > 0);
+        totalClipped += clipped;
+        centre.reset(); shift.reset(); road.reset(); contacts.reset(); leds.clear();
+        assert(!centre.started && !shift.pulsing && !road.started && !contacts.barrier.started);
+        assert(!contacts.traffic.pulse.started && !contacts.barrierTexture.started && !contacts.trafficTexture.started);
+        assert(leds.read(8000, true) == 0);
+        assert(centre.step(steering, .1f, 0, .02f, invert, 8000) == 0);
+        assert(shift.step(3, .3f, 8000) == 0);
+        assert(road.step(1, .9f, .02f, .08f, 1, 8000) == 0);
+        const auto resumed = contacts.step(WallBit | TrafficBit, 0x100, 1, settings, 8000);
+        assert(resumed.sum(0, 0, 0) == 0 && !resumed.barrierTriggered && !resumed.trafficTriggered);
+        std::cout << "COMBINED cadence=" << cadence << " invert=" << invert << " steer=" << steering
+            << " overlapSamples=" << overlapping << " clippedSamples=" << clipped << '\n';
+    }
+    assert(totalClipped > 0); // Exercise actual saturation, not only in-range values.
+    std::cout << "PASS: all-effects plus 20% drift damping, actual model overlap/reset, LED mailbox, hard 50% cap; synthetic only, not hardware validation\n";
+}
diff --git a/tests/contact_models_test.cpp b/tests/contact_models_test.cpp
new file mode 100644
index 0000000..9594b6e
--- /dev/null
+++ b/tests/contact_models_test.cpp
@@ -0,0 +1,253 @@
+// Offline numeric models only. No Device instances, game launch or hardware calls.
+#include "../src/contact_models.hpp"
+#include <cassert>
+#include <climits>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <sstream>
+#include <string>
+#include <vector>
+using namespace NativeFfb;
+using namespace NativeFfb::Experimental;
+static_assert(sizeof(void*) == 4, "Use the Win32 MSVC toolchain for these baseline checks");
+
+static void synthetic()
+{
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    const float inf = std::numeric_limits<float>::infinity();
+    for (uint64_t cadence : {1ull, 16ull, 17ull, 33ull, 40ull})
+    {
+        ContactTexture texture;
+        LONG lo = 0, hi = 0;
+        for (uint64_t now = 0; now <= 3000; now += cadence)
+        {
+            const LONG value = texture.step(Contact::Present, 1, .05f, 1, now);
+            lo = (std::min)(lo, value); hi = (std::max)(hi, value);
+            assert(std::abs(value) <= 500);
+            assert(texture.amplitude <= 500 * (std::min)(1.f, float(now) / 60) + .001f);
+            if (now == 0) assert(value == 0);
+        }
+        assert(lo < -400 && hi > 400 && texture.amplitude == 500);
+        const auto next = texture.tick + cadence;
+        const auto phase = texture.phase;
+        assert(texture.step(Contact::Absent, 1, .05f, 1, next) == 0 && texture.amplitude == 0);
+        assert(std::abs(texture.phase - std::fmod(phase + 8 * double(cadence) / 1000, 1.0)) < 1e-10);
+        assert(texture.step(Contact::Present, 1, .05f, 1, next + cadence) == 0); // Fresh edge starts at zero.
+        texture.step(Contact::Present, 1, .05f, 1, next + 2 * cadence);
+        assert(texture.amplitude > 0);
+        assert(texture.step(Contact::Unknown, 1, .05f, 1, next + 3 * cadence) == 0 && !texture.started);
+    }
+    ContactTexture t;
+    auto prime = [&] {
+        t.reset(); t.step(Contact::Present, 1, .5f, 1, 0);
+        t.step(Contact::Present, 1, .5f, 1, 20);
+        assert(t.amplitude > 0);
+    };
+    for (uint64_t gap : {41ull, 99ull, 100ull, 1000ull})
+    {
+        prime(); assert(t.step(Contact::Present, 1, .5f, 1, 20 + gap) == 0 && t.amplitude == 0);
+    }
+    prime(); t.step(Contact::Present, 1, .5f, 1, 60); assert(t.amplitude == 5000); // Exactly 40ms valid.
+    prime(); assert(t.step(Contact::Present, 1, .5f, 1, 20) == 0 && !t.started); // Duplicate.
+    prime(); assert(t.step(Contact::Present, 1, .5f, 1, 19) == 0 && t.amplitude == 0); // Backward.
+    for (float speed : {0.f, .001f, -1.f, 11.f, nan, inf})
+    { prime(); assert(t.step(Contact::Present, speed, .5f, 1, 40) == 0 && !t.started); }
+    for (float strength : {0.f, -1.f, nan, inf})
+    { prime(); assert(t.step(Contact::Present, 1, strength, 1, 40) == 0 && !t.started); }
+    for (float fullSpeed : {0.f, .049f, 10.1f, nan, inf})
+    { prime(); assert(t.step(Contact::Present, 1, .5f, fullSpeed, 40) == 0 && !t.started); }
+    prime(); assert(t.step(Contact(99), 1, .5f, 1, 40) == 0 && !t.started);
+    prime(); t.step(Contact::Present, 1, .001f, 1, 40); assert(t.amplitude <= 10); // Lower cap immediate.
+    prime(); t.step(Contact::Present, .01f, .5f, 1, 40); assert(t.amplitude <= 50); // Speed drop cap immediate.
+    for (float fullSpeed : {.05f, 1.f, 2.f, 10.f})
+    {
+        t.reset();
+        for (uint64_t now = 0; now <= 120; now += 10) t.step(Contact::Present, 1, 2, fullSpeed, now);
+        assert(std::abs(t.amplitude - 10000 * (std::min)(1.f, 1 / fullSpeed)) < .01f);
+    }
+    // Irregular cadence and contact flicker: absent samples always zero, phase remains time-based.
+    t.reset();
+    uint64_t now = 0;
+    for (unsigned i = 0; i < 500; ++i)
+    {
+        now += i % 3 == 0 ? 33 : 16;
+        const bool contact = i % 5 != 0;
+        const auto value = t.step(contact ? Contact::Present : Contact::Absent, 1, .05f, 1, now);
+        if (!contact) assert(value == 0 && t.amplitude == 0);
+        assert(std::abs(value) <= 500);
+    }
+
+    TrafficJolt traffic;
+    traffic.step(0, 1, .5f, 0);
+    assert(traffic.step(TrafficBit, 1, .5f, 10) == 0 && traffic.pulse.triggered);
+    assert(traffic.step(0, 1, .5f, 40) == 5000); // One-sample hit continues its envelope.
+    traffic.step(0, 1, .5f, 70);
+    assert(traffic.step(0, 1, .5f, 100) == -5000);
+    assert(traffic.step(0, 1, .5f, 130) == 0);
+    assert(!traffic.pulse.pulsing);
+    traffic.reset();
+    traffic.step(TrafficBit, 1, .5f, 0); // Attach on held contact must not kick.
+    for (now = 10; now <= 1000; now += 10)
+        assert(traffic.step(TrafficBit, 1, .5f, now) == 0 && !traffic.pulse.triggered);
+    traffic.step(0, 1, .5f, 1010);
+    traffic.step(TrafficBit, 1, .5f, 1020); assert(traffic.pulse.triggered);
+    traffic.step(TrafficBit, 1, .5f, 1020); assert(!traffic.pulse.started); // Duplicate invalidates.
+    traffic.step(TrafficBit, 1, .5f, 1030); assert(!traffic.pulse.triggered);
+    traffic.step(0, 1, .5f, 1040);
+    traffic.step(TrafficBit, 1, .5f, 1081); assert(!traffic.pulse.triggered); // Gap primes.
+    traffic.step(0, 1, .5f, 1080); assert(!traffic.pulse.triggered); // Backward.
+    for (float strength : {0.f, -1.f, nan, inf})
+        assert(traffic.step(TrafficBit, 1, strength, 1100) == 0 && !traffic.pulse.started);
+
+    ContactModels disabled;
+    for (now = 0; now <= 1000; now += 10)
+    {
+        const auto silent = disabled.step(WallBit | TrafficBit, 0x100, 1, ContactSettings{}, now);
+        assert(silent.mix(0, 0, 0) == 0 && !silent.barrierTriggered && !silent.trafficTriggered);
+        assert(!disabled.barrier.started && !disabled.traffic.pulse.started &&
+            !disabled.barrierTexture.started && !disabled.trafficTexture.started);
+    }
+    ContactSettings trafficOnly{0, 0, .5f, 0, 1};
+    disabled.step(0, 0, 1, trafficOnly, 1010);
+    auto trafficOut = disabled.step(WallBit | TrafficBit, 0x100, 1, trafficOnly, 1020);
+    assert(trafficOut.trafficTriggered && !trafficOut.barrierTriggered && !trafficOut.trafficSuppressed);
+
+    ContactSettings settings{.5f, .05f, .5f, .05f, 1};
+    ContactModels models;
+    models.step(0, 0, 1, settings, 0);
+    auto out = models.step(WallBit | TrafficBit, 0x100, 1, settings, 10);
+    assert(out.barrierTriggered && out.trafficSuppressed && !out.trafficTriggered);
+    for (now = 20; now <= 600; now += 10)
+    {
+        out = models.step(WallBit | TrafficBit, 0x100, 1, settings, now);
+        assert(!out.barrierTriggered && !out.trafficTriggered && out.traffic == 0);
+    }
+    models.step(0, 0, 1, settings, 610);
+    out = models.step(TrafficBit, 0, 1, settings, 620); assert(out.trafficTriggered); // Genuine fresh edge after cooldown.
+    out = models.step(TrafficBit | WallBit, 0x100, 1, settings, 630);
+    assert(out.barrierSuppressed && !out.barrierTriggered && out.traffic != 0);
+    for (now = 640; now <= 800; now += 10)
+    { out = models.step(0, 0, 1, settings, now); assert(!out.barrierTriggered && !out.trafficTriggered && out.barrier == 0); }
+    out = models.step(TrafficBit, 0, 1, settings, 810); assert(!out.trafficTriggered); // 500ms cooldown, not queued.
+    for (now = 820; now <= 1110; now += 10) models.step(0, 0, 1, settings, now);
+    out = models.step(TrafficBit, 0, 1, settings, 1120); assert(out.trafficTriggered); // Exactly 500ms.
+    out = models.step(TrafficBit, 0, 1, settings, 1130, false);
+    assert(out.mix(0, 0, 0) == 0 && !models.barrier.started && !models.traffic.pulse.started);
+    assert(!models.trafficTexture.started && !models.barrierTexture.started);
+    out = models.step(TrafficBit, 0, 1, settings, 1140);
+    assert(!out.trafficTriggered && out.trafficScrape == 0);
+    models.reset(); assert(!models.trafficTexture.started);
+
+    // Neutral options must preserve the exact legacy call path, including duplicates/gaps.
+    ContactModels neutral;
+    CollisionJolt legacy;
+    CentreForce centre;
+    ShiftJolt shift;
+    RoadRumble road;
+    uint32_t rng = 7;
+    now = 1000;
+    for (unsigned i = 0; i < 5000; ++i)
+    {
+        rng = rng * 1664525u + 1013904223u;
+        now += std::array<uint64_t, 7>{0, 16, 17, 33, 40, 41, 100}[rng % 7];
+        const uint32_t flags4 = (rng & 1 ? WallBit : 0) | (rng & 2 ? TrafficBit : 0);
+        const uint32_t flags8 = rng & 4 ? 0x100 : 0x800;
+        const float speed = rng & 8 ? 1.f : 0.f;
+        const bool reset = i % 67 == 0;
+        if (reset) { neutral.reset(); legacy.reset(); centre.reset(); shift.reset(); road.reset(); }
+        const auto value = legacy.step(flags4, flags8, speed, .5f, now);
+        out = neutral.step(flags4, flags8, speed, ContactSettings{.5f}, now);
+        assert(out.barrier == value && out.barrierTriggered == legacy.triggered);
+        assert(out.traffic == 0 && out.barrierScrape == 0 && out.trafficScrape == 0);
+        const auto c = centre.step((rng & 16) ? .5f : -.5f, .1f, 0, .02f, false, now);
+        const auto s = shift.step(2 + (rng & 1), .05f, now);
+        const auto r = road.step(speed, .5f, .01f, .05f, 1, now);
+        assert(out.mix(c, s, r) == Mix(c, s, r, value));
+        assert(out.mix(c, s, r, true) == Mix(c, -s, -r, -value));
+    }
+    out = {LONG_MAX, LONG_MAX, LONG_MAX, LONG_MAX};
+    assert(out.mix(LONG_MAX, LONG_MAX, LONG_MAX) == MaxForce);
+    assert(out.mix(0, LONG_MAX, LONG_MAX, true) == -MaxForce);
+    out = {LONG_MIN, LONG_MIN, LONG_MIN, LONG_MIN};
+    assert(out.mix(LONG_MIN, LONG_MIN, LONG_MIN) == -MaxForce);
+    assert(out.mix(0, LONG_MIN, LONG_MIN, true) == MaxForce);
+    out = {100, -200, 30, 40};
+    assert(out.mix(300, 50, -10) == 310 && out.mix(300, 50, -10, true) == 290);
+    std::cout << "PASS: contact models, neutral legacy equivalence, timing/numeric/reset gates, arbitration and one-clamp mix (offline only)\n";
+}
+
+static void replay(const char* path)
+{
+    std::ifstream file(path); assert(file.is_open());
+    std::string line;
+    assert(std::getline(file, line) && line == "case_id,seq,tick_ms,flags4,flags8,speed,valid,reset");
+    ContactModels combined, neutral;
+    CollisionJolt legacy;
+    TrafficJolt soloTraffic;
+    unsigned previousCase = 0, previousSeq = 0, count = 0;
+    uint64_t previousTick = 0;
+    while (std::getline(file, line))
+    {
+        assert(line.size() < 256 && ++count <= 100000);
+        std::replace(line.begin(), line.end(), ',', ' ');
+        std::istringstream row(line);
+        unsigned id, seq, valid, reset;
+        uint64_t tick, flags4, flags8;
+        float speed;
+        assert(row >> id >> seq >> tick >> flags4 >> flags8 >> speed >> valid >> reset);
+        row >> std::ws; assert(row.eof());
+        assert(valid <= 1 && reset <= 1 && std::isfinite(speed) && std::abs(speed) <= 10);
+        assert(id >= 1 && id <= 100 && tick <= 30000 && flags4 <= UINT32_MAX && flags8 <= UINT32_MAX);
+        if (id != previousCase) { assert(id == previousCase + 1 && reset && seq == 1); previousSeq = 0; }
+        assert(seq == previousSeq + 1);
+        if (reset || id != previousCase)
+        { combined.reset(); neutral.reset(); legacy.reset(); soloTraffic.reset(); }
+        ContactOutput out, old;
+        LONG solo = 0;
+        // Match P0's conservative replay history policy, without changing the legacy class.
+        if (!valid || (id == previousCase && tick <= previousTick))
+        { combined.reset(); neutral.reset(); legacy.reset(); soloTraffic.reset(); }
+        else
+        {
+            const auto f4 = uint32_t(flags4), f8 = uint32_t(flags8);
+            const auto legacyForce = legacy.step(f4, f8, speed, .5f, tick);
+            old = neutral.step(f4, f8, speed, ContactSettings{.5f}, tick);
+            assert(old.barrier == legacyForce && old.barrierTriggered == legacy.triggered);
+            assert(old.mix(123, -70, 21) == Mix(123, -70, 21, legacyForce));
+            solo = soloTraffic.step(f4, speed, .5f, tick);
+            out = combined.step(f4, f8, speed, ContactSettings{.5f, .05f, .5f, .05f, 1}, tick);
+        }
+        assert(std::abs(out.barrier) <= 5000 && std::abs(out.traffic) <= 5000 && std::abs(solo) <= 5000);
+        assert(std::abs(out.barrierScrape) <= 500 && std::abs(out.trafficScrape) <= 500);
+        assert((flags4 & WallBit) || out.barrierScrape == 0);
+        assert((flags4 & TrafficBit) || out.trafficScrape == 0);
+        // Actual live boundary: centre already inverted, accents inverted once,
+        // then hard trial cap. Test both full 10% centre extremes on every sample.
+        for (LONG centre : {-1000L, 0L, 1000L})
+            for (bool invert : {false, true})
+                assert(std::abs(LimitOutput(out.sum(centre, 0, 0, invert))) <= DeviceMaxForce);
+        assert(speed > .001f || (out.barrierScrape == 0 && out.trafficScrape == 0));
+        if (old.barrierTriggered) std::cout << "EDGE," << id << ",legacy," << seq << '\n';
+        if (soloTraffic.pulse.triggered) std::cout << "EDGE," << id << ",traffic_candidate," << seq << '\n';
+        if (out.barrierTriggered) std::cout << "EDGE," << id << ",barrier_granted," << seq << '\n';
+        if (out.trafficTriggered) std::cout << "EDGE," << id << ",traffic_granted," << seq << '\n';
+        if (out.barrierSuppressed) std::cout << "EDGE," << id << ",barrier_suppressed," << seq << '\n';
+        if (out.trafficSuppressed) std::cout << "EDGE," << id << ",traffic_suppressed," << seq << '\n';
+        std::cout << "ROW," << id << ',' << seq << ',' << out.barrier << ',' << out.traffic << ','
+            << out.barrierScrape << ',' << out.trafficScrape << ',' << out.mix(0, 0, 0) << ',' << out.sum(0, 0, 0) << '\n';
+        std::cout << "TRIAL," << id << ',' << seq << ',' << LimitOutput(out.sum(0, 0, 0)) << '\n';
+        previousCase = id; previousSeq = seq; previousTick = tick;
+    }
+    assert(file.eof() && count);
+    std::cout << "PASS: " << count << " observed samples through actual C++ models; candidate edges are NOT verified physical impacts\n";
+}
+
+int main(int argc, char** argv)
+{
+    assert(argc == 1 || argc == 2);
+    // Windows exception-style negative status must fail the .cmd runner too.
+    if (argc == 2 && std::string(argv[1]) == "--self-fail") return -1073740791;
+    synthetic();
+    if (argc == 2) replay(argv[1]);
+}
