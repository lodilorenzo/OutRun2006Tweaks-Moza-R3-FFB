+// Model input, NOT a verified game action flag. The isolated live trial below
+// supplies a provisional raw-word estimate; it does not measure tyre slip.
+enum class DriftStatus { Unknown, Grip, Drift };
+
+struct ExperimentalDriftEstimate
+{
+    static constexpr uint64_t EntryMs = 80, NeutralRearmMs = 200;
+    uint64_t tick = 0, pendingTick = 0;
+    bool started = false, ready = false, pending = false;
+    DriftStatus status = DriftStatus::Unknown;
+    void reset() { *this = {}; }
+
+    DriftStatus step(int rawD34, uint32_t flags4, uint32_t flags8, float speed,
+        bool valid, uint64_t now, int enter = 2000, int leave = 1000, float minimumSpeed = .1f)
+    {
+        // ponytail: raw magnitude + hysteresis, NOT a validated drift detector.
+        // Replace with a verified state reader after independent timed controls.
+        if (!valid || rawD34 < -32768 || rawD34 > 32767 || leave < 0 || enter <= leave || enter > 32767 ||
+            !std::isfinite(speed) || !std::isfinite(minimumSpeed) || minimumSpeed < .01f || minimumSpeed > 10 ||
+            speed < minimumSpeed || speed > 10 || (flags4 & 0x30000) || (flags8 & 0x40))
+        {
+            reset(); // Contact/unknown also requires neutral rearm, not merely a timeout.
+            return status;
+        }
+        if (!started || !Fresh(now, tick) || now - tick > 40)
+        {
+            reset();
+            started = true;
+            tick = now;
+            return status;
+        }
+        if (now == tick) return status; // No duplicate-time accumulation or new event.
+        tick = now;
+        const int magnitude = std::abs(rawD34); // Promoted int: -32768 is safe.
+        if (!ready)
+        {
+            if (magnitude > leave) pending = false;
+            else
+            {
+                if (!pending) { pending = true; pendingTick = now; }
+                if (now - pendingTick >= NeutralRearmMs)
+                {
+                    ready = true; pending = false;
+                    status = DriftStatus::Grip;
+                }
+            }
+            return status; // Attach/resume into an existing excursion stays UNKNOWN.
+        }
+        if (status == DriftStatus::Drift)
+        {
+            if (magnitude <= leave) status = DriftStatus::Grip;
+            return status;
+        }
+        if (magnitude < enter) pending = false;
+        else
+        {
+            if (!pending) { pending = true; pendingTick = now; }
+            if (now - pendingTick >= EntryMs) { status = DriftStatus::Drift; pending = false; }
+        }
+        return status;
+    }
+};
+
+struct RoadRumble
+{
+    uint64_t tick = 0;
+    double phase = 0;
+    float amplitude = 0;
+    float driftAmount = 0;
+    bool started = false;
+    static constexpr float DriftBlendMs = 100; // Trial entry/recovery time; not measured drift latency.
+
+    void reset() { *this = {}; }
+
+    LONG step(float speed, float roughness, float roadStrength, float offroadStrength,
+        float fullSpeed, uint64_t now, DriftStatus drift = DriftStatus::Unknown,
+        float driftDampingPercent = 0, float driftFrequency = 8)
+    {
+        if (!std::isfinite(speed) || speed <= 0.001f || speed > 10 ||
+            !std::isfinite(roughness) || roughness < 0 || roughness > 1 ||
+            !std::isfinite(roadStrength) || roadStrength < 0 ||
+            !std::isfinite(offroadStrength) || offroadStrength < 0 ||
+            (roadStrength == 0 && offroadStrength == 0) ||
+            !std::isfinite(fullSpeed) || fullSpeed < 0.05f || fullSpeed > 10)
+        {
+            reset();
+            return 0;
+        }
+        // Suppress undersampled continuous vibration rather than aliasing it
+        // into a one-sided pull. First sample after any gap starts at zero.
+        if (!started || !Fresh(now, tick) || now - tick > 40)
+        {
+            reset();
+            started = true;
+            tick = now;
+            return 0;
+        }
+        const auto elapsed = now - tick;
+        const float dt = float(elapsed) / 1000.0f;
+        tick = now;
+        const float speedGain = std::clamp(speed / fullSpeed, 0.0f, 1.0f);
+        const float surfaceGain = std::clamp(roughness / 0.9f, 0.0f, 1.0f);
+        float strength = std::lerp(std::clamp(roadStrength, 0.0f, MaxStrength),
+            std::clamp(offroadStrength, 0.0f, MaxStrength), surfaceGain);
+        double frequency = 6.0 + 4.0 * speedGain;
+        const bool modifierEnabled = std::isfinite(driftDampingPercent) && driftDampingPercent > 0 && driftDampingPercent <= 100 &&
+            std::isfinite(driftFrequency) && driftFrequency >= 6 && driftFrequency <= 10;
+        if (modifierEnabled)
+        {
+            // Unknown (including collision-contaminated status) returns to neutral
+            // without a recovery kick. Global stops still reset everything immediately.
+            const float targetAmount = drift == DriftStatus::Drift ? 1.0f : 0.0f;
+            const float amountStep = float(elapsed) / DriftBlendMs;
+            driftAmount += std::clamp(targetAmount - driftAmount, -amountStep, amountStep);
+        }
+        else driftAmount = 0; // Disabled/invalid settings never poison the legacy road path.
+        if (driftAmount > 0)
+        {
+            // True percent reduction independent of either road endpoint. Never
+            // amplify/reverse; zero endpoints and the surface/speed ratio survive.
+            strength *= 1.0f - (driftDampingPercent / 100.0f) * driftAmount;
+            frequency = std::lerp(frequency, double(driftFrequency), double(driftAmount));
+        }
+        const float target = strength * speedGain * DI_FFNOMINALMAX;
+        const float slew = 5000.0f * (std::min)(dt, 0.02f);
+        amplitude += std::clamp(target - amplitude, -slew, slew);
+        // Lowering a configured strength never leaves a stronger residual.
+        amplitude = (std::min)(amplitude, strength * DI_FFNOMINALMAX);
+        // ponytail: 6-10 Hz software rumble, >=25 Hz updates required; use hardware periodics for higher frequencies/low FPS.
+        phase = std::fmod(phase + frequency * dt, 1.0);
+        return LONG(std::sin(2 * std::numbers::pi * phase) * amplitude);
+    }
+};
+
+inline LONG Mix(LONG centre, LONG shift, LONG road = 0, LONG collision = 0)
+{
+    return LONG(std::clamp<int64_t>(int64_t(centre) + shift + road + collision, -MaxForce, MaxForce));
+}
+
+// Dedicated output handle, never the SDL/game polling device. Explicit close only:
+// driver/COM calls in a static destructor would run under the DLL loader lock.
+// Effect descriptor pattern reviewed against d-b-c-e/OutRun2006Tweaks-FFB,
+// commit 15f64f29a29e1dbb748a49d16d21b995ba5de83e (MIT, Copyright (c) 2023 emoose;
+// see LICENSE.md). Infinite effects, background access and retry loops are not ported.
+class Device
+{
+    IDirectInputDevice8A* device = nullptr;
+    IDirectInputEffect* effect = nullptr;
+    bool acquired = false;
+    bool savedAutocentre = false;
+    DIPROPDWORD autocentre{};
+
+    static void remember(HRESULT& result, HRESULT next)
+    {
+        if (FAILED(next) && (SUCCEEDED(result) || result == DIERR_NOTACQUIRED || result == DIERR_INPUTLOST))
+            result = next;
+    }
+
+public:
+    Device() = default;
+    Device(const Device&) = delete;
+    Device& operator=(const Device&) = delete;
+    bool opened() const { return device != nullptr; }
+
+    HRESULT open(IDirectInput8A* di, HWND hwnd, int vendor, int product)
+    {
+        if (device || !di || !hwnd || vendor <= 0 || vendor > 65535 || product <= 0 || product > 65535)
+            return E_INVALIDARG;
+        struct Selection { DWORD product; GUID instance{}; unsigned count = 0; } selected{ DWORD(MAKELONG(vendor, product)) };
+        HRESULT hr = di->EnumDevices(DI8DEVCLASS_GAMECTRL,
+            [](LPCDIDEVICEINSTANCEA info, void* context) -> BOOL {
+                auto& s = *static_cast<Selection*>(context);
+                if (info->guidProduct.Data1 == s.product) { s.instance = info->guidInstance; ++s.count; }
+                return DIENUM_CONTINUE;
+            }, &selected, DIEDFL_ATTACHEDONLY);
+        if (FAILED(hr)) return hr;
+        // ponytail: unique VID/PID only; add instance-GUID selection if two identical wheels are needed.
+        if (selected.count != 1) return DIERR_DEVICENOTREG;
+        hr = di->CreateDevice(selected.instance, &device, nullptr);
+        if (FAILED(hr)) return hr;
+        DIDEVCAPS caps{ sizeof(caps) };
+        if (FAILED(hr = device->GetCapabilities(&caps))) return hr;
+        if (!(caps.dwFlags & DIDC_FORCEFEEDBACK)) return DIERR_UNSUPPORTED;
+        if (FAILED(hr = device->SetDataFormat(&c_dfDIJoystick2))) return hr;
+        if (FAILED(hr = device->SetCooperativeLevel(hwnd, DISCL_EXCLUSIVE | DISCL_FOREGROUND))) return hr;
+        DIDEVICEOBJECTINSTANCEA axis{ sizeof(axis) };
+        if (FAILED(hr = device->GetObjectInfo(&axis, DIJOFS_X, DIPH_BYOFFSET))) return hr;
+        if (!(axis.dwFlags & DIDOI_FFACTUATOR) || axis.guidType != GUID_XAxis) return DIERR_UNSUPPORTED;
+        DIEFFECTINFOA info{ sizeof(info) };
+        if (FAILED(hr = device->GetEffectInfo(&info, GUID_ConstantForce))) return hr;
+        if (!(info.dwStaticParams & DIEP_DURATION)) return DIERR_UNSUPPORTED;
+        autocentre = {};
+        autocentre.diph = { sizeof(autocentre), sizeof(DIPROPHEADER), 0, DIPH_DEVICE };
+        if (FAILED(hr = device->GetProperty(DIPROP_AUTOCENTER, &autocentre.diph))) return hr;
+        savedAutocentre = true;
+        auto off = autocentre;
+        off.dwData = DIPROPAUTOCENTER_OFF;
+        return device->SetProperty(DIPROP_AUTOCENTER, &off.diph); // Must be unacquired.
+    }
+
+    HRESULT submit(LONG magnitude)
+    {
+        if (!device) return DIERR_NOTINITIALIZED;
+        HRESULT hr;
+        if (!acquired)
+        {
+            if (FAILED(hr = device->Acquire())) return hr;
+            acquired = true;
+        }
+        if (!effect)
+        {
+            DWORD axis = DIJOFS_X;
+            LONG direction = DI_FFNOMINALMAX; // Explicit positive X; magnitude supplies the sign.
+            DICONSTANTFORCE zero{};
+            DIEFFECT desc{};
+            desc.dwSize = sizeof(desc);
+            desc.dwFlags = DIEFF_CARTESIAN | DIEFF_OBJECTOFFSETS;
+            desc.dwDuration = LeaseMs * 1000; // Device-side expiry even if the game thread hangs.
+            desc.dwGain = DI_FFNOMINALMAX;
+            desc.dwTriggerButton = DIEB_NOTRIGGER;
+            desc.cAxes = 1;
+            desc.rgdwAxes = &axis;
+            desc.rglDirection = &direction;
+            desc.cbTypeSpecificParams = sizeof(zero);
+            desc.lpvTypeSpecificParams = &zero;
+            if (FAILED(hr = device->CreateEffect(GUID_ConstantForce, &desc, &effect, nullptr))) return hr;
+            DIEFFECT actual{};
+            actual.dwSize = sizeof(actual);
+            if (FAILED(hr = effect->GetParameters(&actual, DIEP_DURATION))) return hr;
+            if (!actual.dwDuration || actual.dwDuration > desc.dwDuration) return DIERR_UNSUPPORTED;
+        }
+        if (!magnitude) return effect->Stop();
+        DICONSTANTFORCE force{ LimitOutput(magnitude) };
+        DIEFFECT desc{};
+        desc.dwSize = sizeof(desc);
+        desc.cbTypeSpecificParams = sizeof(force);
+        desc.lpvTypeSpecificParams = &force;
+        // Restart the finite lease on EVERY fresh sample, including unchanged forces.
+        return effect->SetParameters(&desc, DIEP_TYPESPECIFICPARAMS | DIEP_START);
+    }
+
+    HRESULT suspend()
+    {
+        HRESULT hr = S_OK;
+        if (effect)
+        {
+            remember(hr, effect->Stop());
+            effect->Release();
+            effect = nullptr;
+        }
+        if (acquired)
+        {
+            // Continue cleanup even if Stop fails (focus loss/disconnect).
+            remember(hr, device->SendForceFeedbackCommand(DISFFC_STOPALL));
+            remember(hr, device->Unacquire());
+            acquired = false;
+        }
+        return hr;
+    }
+
+    HRESULT close()
+    {
+        HRESULT hr = suspend();
+        if (device)
+        {
+            if (savedAutocentre)
+                remember(hr, device->SetProperty(DIPROP_AUTOCENTER, &autocentre.diph));
+            device->Release();
+            device = nullptr;
+        }
+        savedAutocentre = false;
+        return hr;
+    }
+};
+}
