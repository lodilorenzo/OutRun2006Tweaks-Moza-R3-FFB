+static void CaptureNativeProbe(EVWORK_CAR* car)
+{
+    if (!probeSession || !probeCapture.running() || !car || car != Game::pl_car()) return;
+    // Existing named PC layout only. No actor-pointer reads or guessed action IDs.
+    static_assert(offsetof(EVWORK_CAR, flags_4) == 0x4 && offsetof(EVWORK_CAR, field_8) == 0x8);
+    static_assert(offsetof(EVWORK_CAR, OnRoadPlace_5C) == 0x5c && sizeof(OnRoadPlace) == 0x10);
+    static_assert(offsetof(OnRoadPlace, loadColiType_0) == 0 && offsetof(OnRoadPlace, curStageIdx_C) == 0xc);
+    static_assert(offsetof(EVWORK_CAR, car_id_10) == 0x10 && offsetof(EVWORK_CAR, field_178) == 0x178);
+    static_assert(offsetof(EVWORK_CAR, field_1C4) == 0x1c4 && offsetof(EVWORK_CAR, field_1D0) == 0x1d0);
+    static_assert(offsetof(EVWORK_CAR, field_1D4) == 0x1d4 && offsetof(EVWORK_CAR, cur_gear_208) == 0x208);
+    static_assert(offsetof(EVWORK_CAR, water_flag_24C) == 0x24c && sizeof(car->water_flag_24C) == 16);
+    static_assert(offsetof(EVWORK_CAR, field_264) == 0x264 && offsetof(EVWORK_CAR, field_268) == 0x268);
+    static_assert(offsetof(EVWORK_CAR, field_coli_281) == 0x281 && offsetof(EVWORK_CAR, crush_stiff_time_2F8) == 0x2f8);
+    LARGE_INTEGER begin{};
+    QueryPerformanceCounter(&begin);
+    NativeFfb::Probe::Sample s;
+    s.tick = GetTickCount64();
+    s.timeUs = ProbeMicroseconds(begin);
+    s.inputTick = probeInputTick;
+    if (probePreviousCar != car) { ++probePlayer; probePreviousCar = car; }
+    s.player = probePlayer; // Local ordinal, not an address or verified allocator generation.
+    s.carId = car->car_id_10;
+    s.marker = probeCase;
+    s.mode = Game::current_mode ? *Game::current_mode : -1;
+    s.pauseMenu = s.mode == STATE_SMPAUSEMENU ? 1 : s.mode == STATE_GAME ? 0 : -1;
+    s.focus = Game::GameHwnd() && !IsIconic(Game::GameHwnd()) && GetForegroundWindow() == Game::GameHwnd();
+    s.overlay = Overlay::IsActive;
+    s.binding = Overlay::IsBindingDialogActive || isListeningForInput != ListenState::False;
+    auto* pad = InputManager::instance.getPrimaryGamepad();
+    s.connected = pad && SDL_GamepadConnected(pad);
+    s.inputFresh = probeInputObserved && s.connected && NativeFfb::Fresh(s.tick, s.inputTick);
+    if (s.connected)
+    {
+        s.steer = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTX) / 32768.0f;
+        s.accel = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER);
+        s.brake = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFT_TRIGGER);
+    }
+    s.gear = car->cur_gear_208;
+    s.flags4 = car->flags_4; s.flags8 = car->field_8; // Snapshot BEFORE CalcVibrationValues mutates flags8.
+    s.raw = { car->field_178, car->field_1C4, car->field_1D0, car->field_1D4,
+        car->field_264, car->field_268, car->crush_stiff_time_2F8 };
+    s.raw281 = car->field_coli_281;
+    s.surfaces = std::to_array(car->water_flag_24C);
+    s.stage = car->OnRoadPlace_5C.curStageIdx_C;
+    s.loadType = car->OnRoadPlace_5C.loadColiType_0;
+    s.finite = std::all_of(s.raw.begin(), s.raw.end(), [](float value) { return std::isfinite(value); });
+    // Restrict game lookup calls to the same racing context as native road output.
+    if (s.mode == STATE_GAME && s.loadType <= INT_MAX && Game::GetNowStageNum && Game::GetStageUniqueNum)
+    {
+        s.stageUnique = Game::GetStageUniqueNum(Game::GetNowStageNum(8));
+        DWORD water = 0;
+        s.roughness = NativeFfb::SurfaceRoughness(s.surfaces, int(s.loadType), sub_1149C0, &water);
+        s.surfaceValid = s.roughness >= 0;
+        s.water = water;
+    }
+    if (probeCapture.push(s))
+    {
+        LARGE_INTEGER end{};
+        QueryPerformanceCounter(&end);
+        const auto finish = ProbeMicroseconds(end);
+        probeCapture.samples[probeCapture.count - 1].captureUs = finish >= s.timeUs ? finish - s.timeUs : 0;
+    }
+}
