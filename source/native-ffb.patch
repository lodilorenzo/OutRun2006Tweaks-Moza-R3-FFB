+
+static void replayCollisions(const char* path)
+{
+    std::ifstream file(path);
+    assert(file.is_open());
+    NativeFfb::CollisionJolt collision;
+    std::string line, car;
+    std::vector<unsigned> onsets;
+    unsigned samples = 0, braking = 0, positive = 0, negative = 0;
+    while (std::getline(file, line))
+    {
+        const std::string prefix = "Native FFB collision sample: ";
+        const auto start = line.find(prefix);
+        if (start == std::string::npos) continue;
+        ++samples;
+        std::map<std::string, std::string> row;
+        std::istringstream fields(line.substr(start + prefix.size()));
+        for (std::string field; fields >> field;)
+        {
+            const auto split = field.find('=');
+            assert(split != std::string::npos);
+            row.emplace(field.substr(0, split), field.substr(split + 1));
+        }
+        if (row.at("car") != car) collision.reset();
+        car = row.at("car");
+        if (row.at("racing") != "true" || row.at("focus") != "true" || row.at("pad") != "true" ||
+            row.at("blocked") != "false" || row.at("finite") != "true")
+        {
+            collision.reset();
+            continue;
+        }
+        const LONG force = collision.step(uint32_t(std::stoul(row.at("flags4"), nullptr, 0)),
+            uint32_t(std::stoul(row.at("flags8"), nullptr, 0)), std::stof(row.at("raw1C4")), .50f,
+            std::stoull(row.at("tick")));
+        if (collision.triggered) onsets.push_back(unsigned(std::stoul(row.at("seq"))));
+        assert(std::abs(force) <= 5000);
+        positive += force > 0;
+        negative += force < 0;
+        if (std::stoi(row.at("brake")) > 3276) { ++braking; assert(force == 0); }
+    }
+    assert(samples == 2502 && braking == 178 && positive && negative);
+    // Includes an earlier brake-labelled but brake-released contact-like event.
+    assert((onsets == std::vector<unsigned>{483, 1434, 1983}));
+    std::cout << "PASS: captured-data replay, 2502 samples, 3 narrow onsets, 178 brake-pressed samples silent; not a runtime/hang validation\n";
+}
+
+static void testProbe(const char* fixturePath)
+{
+    using namespace NativeFfb;
+    using namespace NativeFfb::Probe;
+    // Heap allocation is test-only; the game owns one static fixed-capacity buffer.
+    auto c = std::make_unique<Capture>();
+    Sample s;
+    assert(!c->push(s) && !c->canFlush(true, true));
+    assert(!c->start(1000, 999) && !c->start(1000, MaxDurationMs + 1));
+    assert(c->start(1000, 1000) && !c->start(1000, 1000));
+    assert(!c->canFlush(true, true));
+    for (uint64_t t : {1000ull, 1000ull, 1040ull, 1081ull, 1180ull, 1280ull})
+    {
+        s.tick = t;
+        assert(c->push(s)); // Preserve duplicates and 40/41/99/100ms gaps, not inferred ticks.
+    }
+    c->poll(1999); assert(c->running());
+    c->poll(2000); assert(c->reason == Stop::Deadline);
+    assert(!c->canFlush(false, true) && !c->canFlush(true, false));
+    assert(c->canFlush(true, true) && !c->push(s) && c->count == 6);
+    assert(!c->start(3000, 1000));
+    for (auto reason : {Stop::Operator, Stop::Shutdown})
+    {
+        c = std::make_unique<Capture>();
+        assert(c->start(0, 1000)); c->stop(reason);
+        assert(c->reason == reason && c->canFlush(true, true));
+    }
+    c = std::make_unique<Capture>();
+    assert(c->start(1000, 1000)); c->poll(999); assert(c->reason == Stop::Clock);
+    c = std::make_unique<Capture>();
+    assert(c->start(0, MaxDurationMs));
+    for (size_t i = 0; i < Capacity; ++i) { s.tick = i; assert(c->push(s)); }
+    assert(c->reason == Stop::Full && c->count == Capacity && !c->push(s));
+    assert(c->samples.front().tick == 0 && c->samples.back().tick == Capacity - 1);
+
+    DWORD water = 123;
+    auto lookup = [](unsigned mask, int, DWORD* wet) -> double { if (mask == 2) *wet |= 1; return mask == 1 ? 0 : .75; };
+    assert(SurfaceRoughness({1,2,0,0}, 0, lookup, &water) == .75f && water == 1);
+    assert(SurfaceRoughness({2,3,0,0}, 0, lookup, &water) == -1 && water == 0);
+    water = 123;
+    assert(SurfaceRoughness({0,0,0,0}, 0, lookup, &water) == -1 && water == 0);
+    assert(SurfaceRoughness({1,0,0,0}, 0, lookup, &water) == 0 && water == 0);
+
+    c = std::make_unique<Capture>();
+    assert(c->start(1000, 1000)); s = {};
+    s.player = 1; s.carId = 2; s.mode = 0x10; s.pauseMenu = 0;
+    s.focus = s.connected = s.inputFresh = s.finite = s.surfaceValid = true;
+    s.raw = {.5f, .5f, 0, 0, 0, 0, 0}; s.gear = 2;
+    s.surfaces = {1,1,1,1}; s.roughness = 0;
+    CollisionJolt collision;
+    unsigned onsets = 0;
+    for (unsigned i = 0; i < 40; ++i)
+    {
+        s.tick = s.inputTick = 1000 + i * 16; s.timeUs = i * 16000;
+        // Synthetic separate contacts. Markers are not detector ground truth.
+        s.flags4 = i == 1 || i == 35 ? 0x20000 : 0;
+        s.flags8 = s.flags4 ? 0x100 : 0; s.marker = 2;
+        assert(c->push(s));
+        collision.step(s.flags4, s.flags8, s.raw[1], .5f, s.tick);
+        onsets += collision.triggered;
+    }
+    assert(onsets == 2); c->stop(Stop::Operator);
+    std::ostringstream out; WriteCapture(out, *c);
+    assert(out.str().starts_with("# native-ffb-p0-v1 count=40 ") && out.str().ends_with("# end count=40\n"));
+    if (fixturePath)
+    {
+        std::ofstream file(fixturePath, std::ios::binary | std::ios::trunc);
+        assert(file.is_open()); WriteCapture(file, *c); file.close(); assert(file.good());
+    }
+    std::cout << "PASS: P0 buffer/deadline/full/clock/flush gates, surface+water validity and synthetic model replay (no hardware)\n";
+}
+
+static void replayProbe(const char* path)
+{
+    // Use the strict Python integrity checker first. Feed actual CollisionJolt,
+    // not copied force math. This does not validate new candidate signals.
+    std::ifstream file(path); assert(file.is_open());
+    std::string line;
+    assert(std::getline(file, line) && line.starts_with("# native-ffb-p0-v1 "));
+    assert(std::getline(file, line));
+    std::vector<std::string> names;
+    std::istringstream header(line);
+    for (std::string name; std::getline(header, name, ',');) names.push_back(name);
+    NativeFfb::CollisionJolt collision;
+    std::string identity;
+    uint64_t previousTick = 0;
+    unsigned count = 0;
+    bool footer = false;
+    while (std::getline(file, line))
+    {
+        if (line.starts_with("# end count=")) { assert(std::stoul(line.substr(12)) == count); footer = true; break; }
+        std::map<std::string, std::string> row;
+        std::istringstream fields(line);
+        size_t index = 0;
+        for (std::string value; std::getline(fields, value, ',');) { assert(index < names.size()); row.emplace(names[index++], value); }
+        assert(index == names.size() && std::stoul(row.at("seq")) == ++count);
+        const auto tick = std::stoull(row.at("tick"));
+        const auto key = row.at("player") + "/" + row.at("car_id") + "/" + row.at("stage") + "/" + row.at("load_type");
+        if (key != identity) collision.reset();
+        identity = key;
+        const bool valid = row.at("mode") == "16" && row.at("focus") == "1" && row.at("pad") == "1" &&
+            row.at("overlay") == "0" && row.at("binding") == "0" && row.at("input_fresh") == "1" && row.at("finite") == "1";
+        if (!valid || (count > 1 && tick <= previousTick)) collision.reset();
+        else
+        {
+            collision.step(uint32_t(std::stoul(row.at("flags4"))), uint32_t(std::stoul(row.at("flags8"))),
+                std::stof(row.at("raw1C4")), .5f, tick);
+            if (collision.triggered) std::cout << "P0 replay onset seq=" << count << '\n';
+        }
+        previousTick = tick;
+    }
+    assert(footer && !std::getline(file, line));
+    std::cout << "PASS: P0 CSV replay through actual CollisionJolt, " << count << " samples; no signal-validation claim\n";
+}
+
+int main(int argc, char** argv)
+{
+    assert(argc == 1 || argc == 2 || argc == 3);
+    if (argc == 2) replayCollisions(argv[1]);
+    const bool writeFixture = argc == 3 && std::string(argv[1]) == "--write-probe-fixture";
+    if (argc == 3 && !writeFixture) { assert(std::string(argv[1]) == "--probe-csv"); replayProbe(argv[2]); }
+    testProbe(writeFixture ? argv[2] : nullptr);
+    using namespace NativeFfb;
+    const auto hwnd = reinterpret_cast<HWND>(1); // Never passed to Windows, only the fake.
+    static_assert(MaxForce == 10000 && MaxStrength == 1.0f && ShiftJolt::MaxStrength == 1.0f);
+    static_assert(CentreForce::MaxStrength == 1.0f && CollisionJolt::MaxStrength == 1.0f);
+    // Actual output, not a normalized old cap: zero, old presets, 100%, and over-range clamp.
+    for (float strength : { 0.0f, .01f, .10f, .50f, 1.0f, 2.0f })
+    {
+        const LONG expected = LONG(std::clamp(strength, 0.0f, 1.0f) * 10000);
+        CentreForce centre;
+        RoadRumble road, offroad;
+        for (uint64_t time = 0; time <= 10000; time += 10)
+        {
+            assert(std::abs(centre.step(1, strength, 0, .02f, false, time)) <= expected);
+            assert(std::abs(road.step(1, 0, strength, 0, 1, time)) <= expected);
+            assert(std::abs(offroad.step(1, .9f, 0, strength, 1, time)) <= expected);
+        }
+        assert(centre.level == -expected && road.amplitude == expected && offroad.amplitude == expected);
+        ShiftJolt shift;
+        shift.step(2, strength, 0);
+        shift.step(3, strength, 10);
+        // Decimal float strengths can truncate one DI unit in the double-precision sine.
+        assert(std::abs(shift.step(3, strength, 50) - expected) <= 1);
+        assert(std::abs(shift.step(3, strength, 130) + expected) <= 1);
+        CollisionJolt contact;
+        contact.step(0, 0, .5f, strength, 0);
+        contact.step(0x20000, 0x100, .5f, strength, 10);
+        assert(std::abs(contact.step(0x20000, 0x100, .5f, strength, 40) - expected) <= 1);
+        contact.step(0x20000, 0x100, .5f, strength, 70);
+        assert(std::abs(contact.step(0x20000, 0x100, .5f, strength, 100) + expected) <= 1);
+    }
+    CentreForce left, right;
+    for (uint64_t time = 0; time <= 1000; time += 10)
+    {
+        LONG l = left.step(-1, .10f, 0, .02f, false, time);
+        LONG r = right.step(1, .10f, 0, .02f, false, time);
+        assert(l == -r && l >= 0 && l <= MaxForce);
+        assert(l <= LONG(time)); // Slew limit in DI units per millisecond.
+    }
+    assert(left.level == 1000 && right.level == -1000);
+    assert(left.step(0, .05f, 0, .02f, false, 1010) == 0);
+    assert(right.step(-1, .05f, 0, .02f, false, 1010) >= 0); // No wrong-side residual.
+    assert(right.step(1, .05f, 0, .02f, false, 1110) == 0); // Stale -> fresh ramp.
+    assert(right.step(1, .05f, 0, .02f, false, 1000) == 0); // Backward clock.
+    for (float invalid : { std::numeric_limits<float>::quiet_NaN(), std::numeric_limits<float>::infinity(), -2.0f, 2.0f })
+        assert(left.step(invalid, .05f, 0, .02f, false, 1020) == 0);
+    for (float invalid : { std::numeric_limits<float>::quiet_NaN(), std::numeric_limits<float>::infinity(), -1.0f, 0.0f })
+        assert(left.step(1, invalid, 0, .02f, false, 1020) == 0);
+    assert(left.step(1, .05f, .5f, .02f, false, 1020) == 0);
+    assert(left.step(1, .05f, 0, -.1f, false, 1020) == 0);
+    assert(left.step(1, .05f, 0, std::numeric_limits<float>::quiet_NaN(), false, 1020) == 0);
+    left.reset(); right.reset();
+    for (uint64_t time = 0; time <= 1000; time += 10)
+    {
+        assert(left.step(1, 100, 0, .02f, false, time) == -right.step(1, .10f, 0, .02f, true, time));
+    }
+    assert(left.level == -1000 && right.level == 1000); // Not silently clipped to the old 5% cap.
+    assert(std::abs(left.step(1, .001f, 0, .02f, false, 1010)) <= 10); // Lower cap immediately.
+    assert(left.step(.12f, .05f, .12f, .02f, false, 1020) == 0); // Calibrated centre.
+
+    // Real gear edges, not paddles: one smooth two-sided pulse, never on baseline/resume.
+    for (auto gears : { std::pair{ 1u, 2u }, std::pair{ 6u, 5u } })
+    {
+        ShiftJolt jolt;
+        assert(jolt.step(gears.first, .03f, 0) == 0);
+        assert(jolt.step(gears.second, .03f, 10) == 0);
+        long integral = 0;
+        for (uint64_t age = 1; age <= ShiftJolt::DurationMs; ++age)
+        {
+            LONG force = jolt.step(gears.second, .03f, 10 + age);
+            assert(std::abs(force) <= 300);
+            if (age == 40) assert(force >= 299);
+            if (age == 120) assert(force <= -299);
+            integral += force;
+        }
+        assert(std::abs(integral) <= 2 && !jolt.pulsing);
+        assert(jolt.step(gears.second, .03f, 180) == 0); // Held gear never repeats.
+    }
+    ShiftJolt jolt;
+    assert(jolt.step(2, .03f, 0) == 0);
+    assert(jolt.step(3, .03f, 10) == 0);
+    jolt.step(4, .03f, 30); // Another shift must not extend or stack this pulse.
+    assert(jolt.step(4, .03f, 50) >= 299);
+    assert(jolt.step(4, .03f, 130) <= -299);
+    assert(jolt.step(4, .03f, 170) == 0 && !jolt.pulsing);
+    assert(jolt.step(5, .03f, 180) == 0 && !jolt.pulsing); // Cooldown, no queued jolt.
+    for (uint64_t time = 200; time <= 320; time += 20) assert(jolt.step(5, .03f, time) == 0);
+    assert(jolt.step(6, .03f, 330) == 0);
+    assert(jolt.step(6, .03f, 370) >= 299);
+    jolt.reset(); // Same path as pause/focus loss/disconnect/exit/car replacement.
+    assert(jolt.step(3, .03f, 380) == 0 && !jolt.pulsing);
+    assert(jolt.step(3, .03f, 390) == 0);
+    assert(jolt.step(5, .03f, 400) == 0 && !jolt.pulsing); // Non-adjacent jump is not a shift effect.
+    assert(jolt.step(6, .03f, 410) == 0);
+    assert(jolt.step(6, .03f, 510) == 0 && !jolt.pulsing); // Stale callback cannot resume old pulse.
+    assert(jolt.step(5, .03f, 520) == 0);
+    assert(jolt.step(5, .03f, 500) == 0 && !jolt.pulsing); // Backward clock.
+    for (uint32_t invalid : { 0u, 7u, 0xFFFFFFFFu })
+    {
+        assert(jolt.step(invalid, .03f, 530) == 0);
+        assert(jolt.step(2, .03f, 540) == 0 && !jolt.pulsing);
+    }
+    for (float invalid : { 0.0f, -1.0f, std::numeric_limits<float>::infinity(), std::numeric_limits<float>::quiet_NaN() })
+    {
+        jolt.reset();
+        jolt.step(2, .03f, 0);
+        jolt.step(3, .03f, 10);
+        assert(jolt.step(3, invalid, 50) == 0 && !jolt.pulsing);
+        assert(jolt.step(3, .03f, 60) == 0 && !jolt.pulsing);
+    }
+    jolt.reset();
+    jolt.step(2, 100, 0);
+    jolt.step(3, 100, 10);
+    assert(jolt.step(3, 100, 50) == 10000); // Clamp even when bypassing the settings registry.
+    assert(jolt.step(3, .50f, 130) == -5000); // Existing numeric values retain their meaning.
+    assert(Mix(4900, 300) == 5200 && Mix(-4900, -300) == -5200);
+    assert(Mix(900, -300) == 600 && Mix(-900, 300) == -600);
+    assert(Mix(1000, 5000, 500) == 6500 && Mix(-1000, -5000, -500) == -6500);
+    assert(Mix(LONG_MAX, LONG_MAX, LONG_MAX) == MaxForce && Mix(LONG_MIN, LONG_MIN, LONG_MIN) == -MaxForce);
+    assert(Mix(0, 0) == 0 && Mix(500, 0) == 500); // Disabled accents preserve centring.
+    assert(Mix(LONG_MAX, LONG_MAX) == MaxForce && Mix(LONG_MIN, LONG_MIN) == -MaxForce);
+
+    static_assert(CollisionJolt::MaxStrength == 1.0f);
+    CollisionJolt collision;
+    assert(collision.step(0, 0, .5f, .50f, 0) == 0);
+    assert(collision.step(0x20000, 0x100, .5f, .50f, 10) == 0 && collision.triggered);
+    long collisionIntegral = 0;
+    for (uint64_t age = 1; age <= CollisionJolt::DurationMs; ++age)
+    {
+        const LONG force = collision.step(0x20000, 0x100, .5f, .50f, 10 + age);
+        assert(std::abs(force) <= 5000 && !collision.triggered);
+        if (age == 30) assert(force == 5000);
+        if (age == 90) assert(force == -5000);
+        collisionIntegral += force;
+    }
+    assert(std::abs(collisionIntegral) <= 2 && !collision.pulsing);
+    for (uint64_t time = 140; time <= 600; time += 20)
+        assert(collision.step(0x20000, 0x100, .5f, .50f, time) == 0); // Held signature never repeats.
+    auto primeCollision = [&] {
+        collision.reset();
+        assert(collision.step(0, 0, .5f, .50f, 0) == 0);
+        assert(collision.step(0x20000, 0x100, .5f, .50f, 10) == 0 && collision.triggered);
+    };
+    primeCollision();
+    collision.step(0, 0, .5f, .50f, 20);
+    collision.step(0x20000, 0x100, .5f, .50f, 30);
+    assert(collision.pulseTick == 10 && !collision.triggered); // No stacking/extension.
+    for (uint64_t time = 40; time <= 140; time += 20) collision.step(0, 0, .5f, .50f, time);
+    assert(collision.step(0x20000, 0x100, .5f, .50f, 150) == 0 && !collision.triggered); // Cooldown, not queued.
+    for (uint64_t time = 160; time <= 500; time += 20) assert(collision.step(0, 0, .5f, .50f, time) == 0);
+    assert(collision.step(0x20000, 0x100, .5f, .50f, 510) == 0 && collision.triggered);
+    primeCollision();
+    assert(collision.step(0x20000, 0x100, .5f, 100, 40) == 10000); // Clamp even bypassing settings.
+    assert(std::abs(collision.step(0x20000, 0x100, .5f, .001f, 41)) <= 10);
+    assert(collision.step(0x20000, 0x100, .5f, .50f, 82) == 0 && !collision.pulsing); // >40ms gap.
+    assert(collision.step(0x20000, 0x100, .5f, .50f, 80) == 0 && !collision.triggered); // Backward clock.
+    assert(collision.step(0x20000, 0x100, .5f, .50f, 180) == 0 && !collision.triggered); // Lease-sized gap.
+    for (auto values : { std::pair{0.f,.5f}, std::pair{-1.f,.5f}, std::pair{11.f,.5f},
+            std::pair{std::numeric_limits<float>::quiet_NaN(),.5f},
+            std::pair{std::numeric_limits<float>::infinity(),.5f}, std::pair{.5f,0.f}, std::pair{.5f,-1.f},
+            std::pair{.5f,std::numeric_limits<float>::quiet_NaN()}, std::pair{.5f,std::numeric_limits<float>::infinity()} })
+    {
+        primeCollision();
+        assert(collision.step(0x20000, 0x100, values.first, values.second, 40) == 0 && !collision.started);
+        assert(collision.step(0x20000, 0x100, .5f, .50f, 50) == 0 && !collision.triggered);
+    }
+    collision.reset(); // Lifecycle/car replacement shares this reset.
+    assert(collision.step(0x20000, 0x100, .5f, .50f, 0) == 0 && !collision.triggered);
+    for (uint64_t time = 10; time <= 100; time += 10)
+    {
+        assert(collision.step(0x20000, 0x800, .5f, .50f, time) == 0); // Scrape-only signature excluded.
+        assert(collision.step(0x10000, 0x1000, .5f, .50f, time) == 0); // No guessed traffic fallback.
+        assert(collision.step(0, 0x100, .5f, .50f, time) == 0); // Both bits required.
+    }
+    assert(Mix(1000, 5000, 500, 5000) == 10000 && Mix(-1000, -5000, -500, -5000) == -10000);
+    assert(Mix(100, 200, 300, -400) == 200 && Mix(100, 200, 300, 0) == Mix(100, 200, 300));
+    assert(Mix(LONG_MAX, LONG_MAX, LONG_MAX, LONG_MAX) == MaxForce);
+    assert(Mix(LONG_MIN, LONG_MIN, LONG_MIN, LONG_MIN) == -MaxForce);
+
+    static int lookupCalls = 0;
+    auto lookup = [](unsigned mask, int loadType, DWORD* water) -> double {
+        ++lookupCalls;
+        assert(loadType == 42 && water);
+        if (mask == 2) *water |= 1;
+        return mask == 1 ? 0.0 : mask == 2 ? 0.25 : mask == 4 ? 0.7 : 0.9;
+    };
+    assert(std::abs(SurfaceRoughness({ 1, 2, 4, 8 }, 42, lookup) - .9f) < .00001f && lookupCalls == 4);
+    lookupCalls = 0;
+    assert(SurfaceRoughness({ 0, 1, 0, 2 }, 42, lookup) == .25f && lookupCalls == 2);
+    assert(SurfaceRoughness({ 0, 0, 0, 0 }, 42, lookup) == -1);
+    assert(SurfaceRoughness({ 3, 0, 0, 0 }, 42, lookup) == -1);
+    assert(SurfaceRoughness({ 0x1000000, 0, 0, 0 }, 42, lookup) == -1);
+    assert(SurfaceRoughness({ 1, 0, 0, 0 }, 42, nullptr) == -1);
+    assert(SurfaceRoughness({ 1, 0, 0, 0 }, 0, [](unsigned, int, DWORD*) -> double {
+        return std::numeric_limits<double>::quiet_NaN(); }) == -1);
+
+    RoadRumble cadence;
+    assert(cadence.step(1, .9f, .01f, .05f, 1, 0) == 0);
+    assert(cadence.step(1, .9f, .01f, .05f, 1, 40) > 0);
+    assert(cadence.step(1, .9f, .01f, .05f, 1, 80) < 0); // 25 Hz sampling still spans both polarities.
+    assert(cadence.step(1, .9f, .01f, .05f, 1, 121) == 0); // Slower sampling resets to silence.
+    RoadRumble smooth, rough, scaled;
+    LONG smoothPeak = 0, roughPeak = 0, roughLow = 0;
+    for (uint64_t time = 0; time <= 1000; time += 10)
+    {
+        const LONG a = smooth.step(1, 0, .01f, .05f, 1, time);
+        const LONG b = rough.step(1, .9f, .01f, .05f, 1, time);
+        scaled.step(1, .9f, .01f, .05f, 2, time);
+        assert(std::abs(a) <= 100 && std::abs(b) <= 500);
+        smoothPeak = (std::max)(smoothPeak, a);
+        roughPeak = (std::max)(roughPeak, b);
+        roughLow = (std::min)(roughLow, b);
+    }
+    assert(smoothPeak >= 90 && roughPeak >= 450 && roughLow <= -450);
+    assert(std::abs(smooth.amplitude - 100) < 1 && std::abs(rough.amplitude - 500) < 1);
+    assert(std::abs(scaled.amplitude - 250) < 1); // Raw-speed calibration affects the envelope.
+    smooth.step(1, .9f, .01f, .05f, 1, 1010);
+    assert(smooth.amplitude <= 151); // Surface onset ramps instead of jumping to 500.
+    assert(rough.step(0, .9f, .01f, .05f, 1, 1010) == 0 && !rough.started); // Stationary.
+    assert(rough.step(1, .9f, .01f, .05f, 1, 1020) == 0); // Resume starts at zero.
+    assert(rough.step(1, .9f, .01f, .05f, 1, 1061) == 0 && rough.amplitude == 0); // Low-FPS suppression.
+    assert(rough.step(1, .9f, .01f, .05f, 1, 1200) == 0); // Stale callback.
+    assert(rough.step(1, .9f, .01f, .05f, 1, 1190) == 0); // Backward clock.
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    const float inf = std::numeric_limits<float>::infinity();
+    for (auto values : { std::array{nan,.5f,.01f,.05f,1.f}, std::array{inf,.5f,.01f,.05f,1.f},
+            std::array{-1.f,.5f,.01f,.05f,1.f}, std::array{11.f,.5f,.01f,.05f,1.f},
+            std::array{1.f,-1.f,.01f,.05f,1.f}, std::array{1.f,1.1f,.01f,.05f,1.f},
+            std::array{1.f,nan,.01f,.05f,1.f}, std::array{1.f,.5f,nan,.05f,1.f},
+            std::array{1.f,.5f,-.01f,.05f,1.f}, std::array{1.f,.5f,.01f,inf,1.f},
+            std::array{1.f,.5f,.01f,-.05f,1.f}, std::array{1.f,.5f,0.f,0.f,1.f},
+            std::array{1.f,.5f,.01f,.05f,0.f}, std::array{1.f,.5f,.01f,.05f,11.f},
+            std::array{1.f,.5f,.01f,.05f,nan} })
+    {
+        rough.step(1, .9f, .01f, .05f, 1, 1000);
+        rough.step(1, .9f, .01f, .05f, 1, 1020);
+        assert(rough.step(values[0], values[1], values[2], values[3], values[4], 1040) == 0);
+        assert(!rough.started && rough.amplitude == 0);
+    }
+    rough.reset();
+    for (uint64_t time = 0; time <= 2000; time += 10)
+        assert(std::abs(rough.step(1, .9f, 100, 100, 1, time)) <= MaxForce);
+    assert(rough.amplitude == 10000);
+    rough.step(1, .9f, .01f, .01f, 1, 2010);
+    assert(rough.amplitude <= 100); // Lowered configuration cap applies immediately.
+    rough.reset();
+    assert(rough.step(1, .9f, .01f, .05f, 1, 2020) == 0 && rough.amplitude == 0);
+
+    for (int bits = 0; bits < 32; ++bits)
+    {
+        bool enabled = bits & 1, racing = bits & 2, focus = bits & 4, blocked = bits & 8, connected = bits & 16;
+        assert(Allowed(enabled, racing, focus, blocked, connected, 1000, 999, 999) == (bits == 23));
+    }
+    assert(!Allowed(true, true, true, false, true, 1000, 900, 999));
+    assert(!Allowed(true, true, true, false, true, 1000, 999, 900));
+    assert(!Allowed(true, true, true, false, true, 1000, 1001, 999));
+
+    static_assert(DeviceMaxForce == 5000);
+    assert(LimitOutput(INT64_MAX) == 5000 && LimitOutput(INT64_MIN) == -5000);
+    assert(LimitOutput(4999) == 4999 && LimitOutput(-4999) == -4999);
+    assert(LimitOutput(5000) == 5000 && LimitOutput(-5000) == -5000);
+    assert(LimitOutput(5001) == 5000 && LimitOutput(-5001) == -5000);
+    Factory di;
+    Device output;
+    assert(SUCCEEDED(output.close()) && di.t.calls.empty()); // Disabled path is inert.
+    assert(SUCCEEDED(output.open(&di, hwnd, 0x346E, 5)));
+    assert(!di.wheel.acquired && !di.t.count("create.effect"));
+    assert(di.wheel.autocentre == DIPROPAUTOCENTER_OFF);
+    assert(SUCCEEDED(output.submit(0)) && !di.t.count("submit"));
+    assert(SUCCEEDED(output.submit(LONG_MAX)) && di.wheel.fx.output() == DeviceMaxForce);
+    di.wheel.fx.now = 90;
+    assert(SUCCEEDED(output.submit(10000))); // Same value still refreshes the lease.
+    di.wheel.fx.now = 189;
+    assert(di.wheel.fx.output() == DeviceMaxForce);
+    di.wheel.fx.now = 190;
+    assert(di.wheel.fx.output() == 0); // Simulated compliant hardware expiry.
+    assert(SUCCEEDED(output.submit(LONG_MIN)) && di.wheel.fx.output() == -DeviceMaxForce);
+    assert(SUCCEEDED(output.suspend()) && !di.wheel.acquired && di.wheel.fx.output() == 0);
+    assert(di.t.count("effect.release") == 1 && di.t.count("unacquire") == 1);
+    assert(SUCCEEDED(output.submit(0))); // Fresh zero effect after pause/focus recovery.
+    assert(di.t.count("create.effect") == 2 && di.t.count("acquire") == 2);
+    assert(SUCCEEDED(output.close()) && di.wheel.autocentre == DIPROPAUTOCENTER_ON);
+    auto count = di.t.calls.size();
+    assert(SUCCEEDED(output.close()) && di.t.calls.size() == count);
+
+    for (unsigned matches : { 0u, 2u })
+    {
+        Factory f; Device d; f.matches = matches;
+        assert(FAILED(d.open(&f, hwnd, 0x346E, 5)) && !f.t.count("create.device"));
+    }
+    for (const char* stage : { "enum", "create.device", "caps", "format", "cooperative", "axis", "effect.info", "get.autocentre", "autocentre.off" })
+    {
+        Factory f; Device d; f.t.fail = stage;
+        assert(FAILED(d.open(&f, hwnd, 0x346E, 5)));
+        f.t.fail.clear();
+        assert(SUCCEEDED(d.close()) && !f.t.count("acquire") && !f.t.count("submit"));
+        assert(f.wheel.autocentre == DIPROPAUTOCENTER_ON);
+    }
+    for (int unsupported = 0; unsupported < 3; ++unsupported)
+    {
+        Factory f; Device d;
+        if (unsupported == 0) f.wheel.hasFfb = false;
+        if (unsupported == 1) f.wheel.hasAxis = false;
+        if (unsupported == 2) f.wheel.hasDuration = false;
+        assert(FAILED(d.open(&f, hwnd, 0x346E, 5)));
+        assert(SUCCEEDED(d.close()) && !f.t.count("acquire"));
+    }
+    for (const char* stage : { "acquire", "create.effect", "duration", "submit" })
+    {
+        Factory f; Device d;
+        assert(SUCCEEDED(d.open(&f, hwnd, 0x346E, 5)));
+        f.t.fail = stage;
+        assert(FAILED(d.submit(100)) && f.t.count(stage) == 1); // No internal retry.
+        f.t.fail.clear();
+        assert(SUCCEEDED(d.close()) && !d.opened() && !f.wheel.acquired);
+    }
+    for (DWORD duration : { DWORD(0), DWORD(101000), DWORD(INFINITE) })
+    {
+        Factory f; Device d; f.wheel.fx.reportedDuration = duration;
+        assert(SUCCEEDED(d.open(&f, hwnd, 0x346E, 5)));
+        assert(FAILED(d.submit(100)) && !f.t.count("submit"));
+        assert(SUCCEEDED(d.close()));
+    }
+    for (const char* stage : { "stop", "stopall", "unacquire", "autocentre.restore" })
+    {
+        Factory f; Device d;
+        assert(SUCCEEDED(d.open(&f, hwnd, 0x346E, 5)) && SUCCEEDED(d.submit(100)));
+        f.t.fail = stage;
+        assert(FAILED(d.close()) && !d.opened());
+        assert(f.t.count("effect.release") == 1 && f.t.count("unacquire") == 1);
+        assert(f.t.count("autocentre.restore") == 1 && f.t.count("device.release") == 1);
+    }
+    std::cout << "PASS: actual 0..1 strengths, 100% model range / HARD 50% DEVICE CAP, collision signature/pulses/cooldown/reset, centring/road/gear models, gates and device cleanup (fake COM; no hardware)\n";
+}
diff --git a/tests/native_rpm_leds_test.cpp b/tests/native_rpm_leds_test.cpp
new file mode 100644
index 0000000..9f5fec1
--- /dev/null
+++ b/tests/native_rpm_leds_test.cpp
@@ -0,0 +1,80 @@
+#include "../src/native_rpm_leds.hpp"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <vector>
+
+int main()
+{
+    using namespace NativeRpmLeds;
+    const std::vector<uint8_t> zero{0x7e,6,0x41,0x13,0xfd,0xde,0,0,0,0,0xc0};
+    const std::vector<uint8_t> full{0x7e,6,0x41,0x13,0xfd,0xde,0,0,3,255,0xc2};
+    for (unsigned mask = 0; mask <= 1023; ++mask)
+    {
+        const auto encoded = Encode(uint16_t(mask));
+        std::vector<uint8_t> wire(encoded.bytes.begin(), encoded.bytes.begin() + encoded.size);
+        if (mask == 0) assert(wire == zero);
+        if (mask == 1023) assert(wire == full);
+        assert(wire[0] == 0x7e && wire[1] == 6 && encoded.size <= encoded.bytes.size());
+        std::vector<uint8_t> decoded;
+        for (size_t i = 2; i < wire.size(); ++i)
+        {
+            const auto byte = wire[i];
+            decoded.push_back(byte);
+            if (byte == 0x7e) { ++i; assert(i < wire.size() && wire[i] == byte); }
+        }
+        assert(decoded.size() == 9);
+        assert(decoded[0] == 0x41 && decoded[1] == 0x13 && decoded[2] == 0xfd && decoded[3] == 0xde);
+        assert(decoded[4] == 0 && decoded[5] == 0 && decoded[6] * 256u + decoded[7] == mask);
+        unsigned checksum = 0x0d + 0x7e + 6;
+        for (size_t i = 0; i < 8; ++i) checksum += decoded[i] * (decoded[i] == 0x7e ? 2u : 1u);
+        assert(uint8_t(checksum) == decoded[8]);
+    }
+    assert(Encode(126).size == 12); // Escaped payload.
+    assert(Encode(190).size == 12); // Escaped checksum.
+    bool rejected = false;
+    try { (void)Encode(1024); } catch (const std::invalid_argument&) { rejected = true; }
+    assert(rejected);
+
+    assert(ValidRange(4000, 8000));
+    assert(!ValidRange(0, 8000) && !ValidRange(8000, 8000) && !ValidRange(8001, 8000));
+    assert(!ValidRange(100, 20001) && !ValidRange(-1, 8000));
+    assert(Mask(3999, 4000, 8000) == 0 && Mask(4000, 4000, 8000) == 1);
+    assert(Mask(7999, 4000, 8000) == 511 && Mask(8000, 4000, 8000) == 1023);
+    assert(Mask(20000, 4000, 8000) == 1023 && Mask(20001, 4000, 8000) == 0);
+    assert(Mask(0xffffffffu, 4000, 8000) == 0 && Mask(5000, 8000, 4000) == 0);
+    for (const auto range : {std::pair{100,101}, std::pair{4000,8000}, std::pair{100,20000}})
+    {
+        uint16_t previous = 0;
+        for (uint32_t rpm = 0; rpm <= MaxRpm; ++rpm)
+        {
+            const auto mask = Mask(rpm, range.first, range.second);
+            assert(mask >= previous && mask <= FullMask && (mask & (mask + 1)) == 0);
+            previous = mask;
+        }
+        for (unsigned led = 0; led < 10; ++led)
+        {
+            const auto threshold = unsigned(range.first) + (led * unsigned(range.second - range.first) + 8) / 9;
+            assert(Mask(threshold, range.first, range.second) & (1u << led));
+            assert(!(Mask(threshold - 1, range.first, range.second) & (1u << led)));
+        }
+    }
+
+    Mailbox mailbox;
+    assert(mailbox.read(1000, true) == 0);
+    mailbox.publish(1023, 1000);
+    assert(mailbox.read(1000, true) == 1023 && mailbox.read(1249, true) == 1023);
+    assert(mailbox.read(1250, true) == 0 && mailbox.read(999, true) == 0);
+    assert(mailbox.read(1001, false) == 0);
+    mailbox.clear(); // Pause, overlay, focus loss, disconnect, shutdown.
+    assert(mailbox.read(1001, true) == 0);
+    mailbox.publish(1, 2000);
+    assert(mailbox.read(2001, true) == 1);
+    mailbox.publish(1024, 2002);
+    assert(mailbox.read(2002, true) == 0);
+    mailbox.publish(1, 0);
+    assert(mailbox.read(0, true) == 0);
+    mailbox.publish(1, uint64_t{1} << 48);
+    assert(mailbox.read(uint64_t{1} << 48, true) == 0);
+    std::cout << "PASS: R3 LED vectors/all masks, stuffing, bounds, RPM thresholds and atomic sample expiry/clearing (no hardware)\n";
+}
