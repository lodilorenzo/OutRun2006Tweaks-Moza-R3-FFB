+            "raw1C4={:.5f} raw1D0={:.5f} raw1D4={:.5f} raw264={:.5f} raw268={:.5f} finite={} gear={} flags8=0x{:X} surface=0x{:X}",
+            mode, focus, connected, steer, accel, brake, car->field_1C4, car->field_1D0,
+            car->field_1D4, car->field_264, car->field_268, finite, car->cur_gear_208, car->field_8, car->water_flag_24C[0]);
+    }
+}
+
+namespace
+{
+    NativeFfb::Device nativeDevice;
+    NativeFfb::CentreForce nativeCentre;
+    NativeFfb::ShiftJolt nativeShift;
+    NativeFfb::RoadRumble nativeRoad;
+    NativeFfb::ExperimentalDriftEstimate nativeDrift;
+    NativeFfb::Experimental::ContactModels nativeContacts;
+    std::array<int64_t, 3> nativeStageContext{ -1, -1, -1 };
+    std::array<LONG, 4> nativeContactMin{}, nativeContactMax{};
+    uint64_t nativeContactLogTick = 0;
+    unsigned nativeClipped = 0;
+    LONG nativeLastForce = 0;
+    EVWORK_CAR* nativePlayerCar = nullptr;
+    bool nativeArmed = false, nativeFault = false, nativeExiting = false;
+    bool nativeBusy = false, nativeStopPending = false, nativeConnected = false;
+    int nativeVendor = 0, nativeProduct = 0;
+    float nativeSteer = 0;
+    uint64_t nativeInputTick = 0, nativeCarTick = 0, nativeRoadLogTick = 0;
+    LONG nativeRoadMin = 0, nativeRoadMax = 0;
+
+    void ResetNativeModels()
+    {
+        nativeCentre.reset();
+        nativeShift.reset();
+        nativeRoad.reset();
+        nativeDrift.reset();
+        nativeContacts.reset();
+        nativeStageContext = { -1, -1, -1 };
+        nativeContactMin = nativeContactMax = {};
+        nativeContactLogTick = 0;
+        nativeClipped = 0;
+        nativePlayerCar = nullptr;
+        nativeRoadLogTick = 0;
+        nativeRoadMin = nativeRoadMax = 0;
+    }
+
+    bool NativeAllowed(uint64_t now)
+    {
+        return NativeFfb::Allowed(nativeArmed && Settings::NativeFfbEnabled && !NativeFfb_ProbeSession() && !nativeFault && !nativeExiting &&
+            Settings::UseNewInput && Settings::VibrationMode == 0 &&
+            Settings::NativeFfbVendorId == nativeVendor && Settings::NativeFfbProductId == nativeProduct &&
+            std::isfinite(Settings::NativeFfbStrength.get()) && Settings::NativeFfbStrength > 0,
+            Game::current_mode && *Game::current_mode == STATE_GAME,
+            Game::GameHwnd() && !IsIconic(Game::GameHwnd()) && GetForegroundWindow() == Game::GameHwnd(),
+            Overlay::IsActive || Overlay::IsBindingDialogActive || isListeningForInput != ListenState::False,
+            nativeConnected, now, nativeInputTick, nativeCarTick);
+    }
+
+    // DirectInput may dispatch window messages. Defer nested stops until the
+    // in-flight call unwinds; never release an effect from inside its own call.
+    struct NativeCall
+    {
+        NativeCall() { nativeBusy = true; }
+        ~NativeCall()
+        {
+            nativeBusy = false;
+            if (nativeStopPending) NativeFfb_Stop(nativeExiting);
+        }
+    };
+
+    void NativeFail(HRESULT hr)
+    {
+        if (!nativeFault)
+            spdlog::error("Native FFB: output fault 0x{:08X}; disabled until restart", unsigned(hr));
+        nativeFault = true;
+        nativeStopPending = true;
+    }
+
+    void UpdateNativeFfb(EVWORK_CAR* car)
+    {
+        if (!nativeArmed || nativeExiting || nativeBusy || !car || car != Game::pl_car()) return;
+        const auto now = GetTickCount64();
+        const bool duplicateContactTick = car == nativePlayerCar && now <= nativeCarTick;
+        if (car != nativePlayerCar || !NativeFfb::Fresh(now, nativeCarTick))
+            ResetNativeModels();
+        nativePlayerCar = car;
+        nativeCarTick = now;
+        if (!NativeAllowed(now)) { NativeFfb_Stop(); return; }
+        NativeCall call;
+        HRESULT hr = S_OK;
+        if (!nativeDevice.opened())
+        {
+            hr = nativeDevice.open(Game::DirectInput8_ptr ? Game::DirectInput8() : nullptr,
+                Game::GameHwnd(), nativeVendor, nativeProduct);
+            if (FAILED(hr)) { NativeFail(hr); return; }
+            spdlog::info("Native FFB: dedicated foreground output opened, VID={:04X} PID={:04X}, lease={}ms, cap={}%",
+                nativeVendor, nativeProduct, NativeFfb::LeaseMs, NativeFfb::DeviceMaxForce / 100);
+        }
+        // Opening/acquiring a driver can be slow or dispatch a focus/exit message.
+        if (nativeStopPending || !NativeAllowed(GetTickCount64()) || car != Game::pl_car())
+        { nativeStopPending = true; return; }
+        // Same verified stage reads used by P0, only in allowed racing context.
+        const int uniqueStage = Game::GetNowStageNum && Game::GetStageUniqueNum
+            ? Game::GetStageUniqueNum(Game::GetNowStageNum(8)) : -1;
+        const std::array<int64_t, 3> context{ car->OnRoadPlace_5C.curStageIdx_C,
+            car->OnRoadPlace_5C.loadColiType_0, uniqueStage };
+        const bool contactContextValid = uniqueStage >= 0 && context[1] <= INT_MAX;
+        if (context != nativeStageContext)
+        {
+            ResetNativeModels(); // Stage/load changes cannot manufacture impacts or shifts.
+            nativePlayerCar = car;
+            nativeStageContext = context;
+        }
+        const LONG centre = nativeCentre.step(nativeSteer, Settings::NativeFfbStrength,
+            Settings::NativeFfbCentre, Settings::NativeFfbDeadzone, Settings::NativeFfbInvert, now);
+        if (!nativeCentre.started) ResetNativeModels(); // Invalid steering/calibration silences all accents.
+        const uint32_t gear = car->cur_gear_208;
+        const float speed = car->field_1C4;
+        const uint32_t flags4 = car->flags_4, flags8 = car->field_8;
+        const auto surfaces = std::to_array(car->water_flag_24C); // Snapshot before driver callbacks.
+        const bool roadEnabled = Settings::NativeFfbRoadStrength > 0 || Settings::NativeFfbOffroadStrength > 0;
+        const float roughness = roadEnabled ? NativeFfb::SurfaceRoughness(surfaces,
+            int(car->OnRoadPlace_5C.loadColiType_0), sub_1149C0) : -1.0f;
+        // Same direct raw reads/layout already exercised by the no-output recorder.
+        // No pointer chasing, new hook or change to before-original sampling order.
+        static_assert(offsetof(EVWORK_CAR, gapD34) == 0xd34 && sizeof(car->gapD34) == 2);
+        static_assert(offsetof(EVWORK_CAR, flags_2F0) == 0x2f0 && sizeof(car->flags_2F0) == 4);
+        int16_t rawD34 = 0;
+        std::memcpy(&rawD34, car->gapD34, sizeof(rawD34));
+        const bool driftEnabled = Settings::NativeFfbDriftDampingPercent > 0;
+        if (!driftEnabled) nativeDrift.reset();
+        const auto drift = driftEnabled ? nativeDrift.step(rawD34, flags4, flags8, speed,
+            nativeCentre.started && contactContextValid && roughness >= 0 && car->flags_2F0 == 4,
+            now, Settings::NativeFfbDriftEnter, Settings::NativeFfbDriftLeave, Settings::NativeFfbDriftMinimumSpeed)
+            : NativeFfb::DriftStatus::Unknown;
+        // Unknown/contact cannot retain the drift modifier. Healthy recovery
+        // uses the P3 fade; phase and ordinary road feedback remain intact here.
+        if (drift == NativeFfb::DriftStatus::Unknown) nativeRoad.driftAmount = 0;
+        LONG shift = nativeCentre.started ? nativeShift.step(gear, Settings::NativeFfbShiftStrength, now) : 0;
+        LONG road = nativeCentre.started ? nativeRoad.step(speed, roughness, Settings::NativeFfbRoadStrength,
+            Settings::NativeFfbOffroadStrength, Settings::NativeFfbRoadFullSpeed, now,
+            drift, Settings::NativeFfbDriftDampingPercent, Settings::NativeFfbDriftFrequency) : 0;
+        const NativeFfb::Experimental::ContactSettings contactSettings{
+            Settings::NativeFfbCollisionStrength, Settings::NativeFfbScrapeStrength,
+            Settings::NativeFfbTrafficStrength, Settings::NativeFfbTrafficScrapeStrength,
+            Settings::NativeFfbRoadFullSpeed };
+        const auto contact = nativeContacts.step(flags4, flags8, speed, contactSettings, now,
+            nativeCentre.started && contactContextValid && !duplicateContactTick);
+        const int64_t preclamp = contact.sum(centre, shift, road, Settings::NativeFfbInvert);
+        const LONG force = NativeFfb::LimitOutput(preclamp);
+        // Recheck after all game reads/calculation, before the only output submission.
+        if (nativeStopPending || !NativeAllowed(GetTickCount64()) || car != Game::pl_car())
+        { nativeStopPending = true; return; }
+        hr = nativeDevice.submit(force);
+        if (SUCCEEDED(hr)) nativeLastForce = force;
+        if (FAILED(hr)) NativeFail(hr); // Never recreate/retry a failed output automatically.
+        else if (Settings::NativeFfbDiagnostics)
+        {
+            if (contact.barrierTriggered || contact.trafficTriggered || contact.barrierSuppressed || contact.trafficSuppressed)
+                spdlog::info("Native FFB contact trial: barrier={} traffic={} suppressedBarrier={} suppressedTraffic={} flags4=0x{:X} flags8=0x{:X} speed={:.5f}",
+                    contact.barrierTriggered, contact.trafficTriggered, contact.barrierSuppressed, contact.trafficSuppressed, flags4, flags8, speed);
+            const std::array<LONG, 4> components{ contact.barrier, contact.traffic, contact.barrierScrape, contact.trafficScrape };
+            for (size_t i = 0; i < components.size(); ++i)
+            {
+                nativeContactMin[i] = (std::min)(nativeContactMin[i], components[i]);
+                nativeContactMax[i] = (std::max)(nativeContactMax[i], components[i]);
+            }
+            nativeClipped += preclamp != force;
+            if (now - nativeContactLogTick >= 500)
+            {
+                spdlog::info("Native FFB contact trial: barrier={}/{} traffic={}/{} wallTexture={}/{} trafficTexture={}/{} preclamp={} output={} clippedSamples={} cap=5000",
+                    nativeContactMin[0], nativeContactMax[0], nativeContactMin[1], nativeContactMax[1],
+                    nativeContactMin[2], nativeContactMax[2], nativeContactMin[3], nativeContactMax[3], preclamp, force, nativeClipped);
+                nativeContactLogTick = now;
+                nativeContactMin = nativeContactMax = {};
+                nativeClipped = 0;
+            }
+            if (shift)
+                spdlog::info("Native FFB: shift output gear={} jolt={} combined={} result=0x{:08X}",
+                    gear, shift, force, unsigned(hr)); // Accepted command, not measured wheel torque.
+            if (roadEnabled)
+            {
+                nativeRoadMin = (std::min)(nativeRoadMin, road);
+                nativeRoadMax = (std::max)(nativeRoadMax, road);
+                if (now - nativeRoadLogTick >= 500)
+                {
+                    // Min/max catches both waveform polarities without aliasing the 500ms log cadence.
+                    spdlog::info("Native FFB: road output rawSpeed={:.4f} roughness={:.4f} min={} max={} combined={} masks={:X}/{:X}/{:X}/{:X}",
+                        speed, roughness, nativeRoadMin, nativeRoadMax, force, surfaces[0], surfaces[1], surfaces[2], surfaces[3]);
+                    if (driftEnabled)
+                        spdlog::info("Native FFB DRIFT ESTIMATE: rawD34={} raw2F0=0x{:X} state={} amount={:.3f} amplitudeDI={:.1f} dampingPercent={} frequency={} (0 unknown/1 grip/2 estimated drift; NOT validated)",
+                            rawD34, car->flags_2F0, int(drift), nativeRoad.driftAmount, nativeRoad.amplitude,
+                            Settings::NativeFfbDriftDampingPercent.get(), Settings::NativeFfbDriftFrequency.get());
+                    nativeRoadLogTick = now;
+                    nativeRoadMin = nativeRoadMax = 0;
+                }
+            }
+        }
+    }
+}
+
+void NativeFfb_Stop(bool shutdown)
+{
+    if (shutdown && NativeFfb_ProbeSession()) probeCapture.stop(NativeFfb::Probe::Stop::Shutdown);
+    nativeExiting |= shutdown;
+    nativeStopPending = true;
+    ResetNativeModels();
+    if (nativeBusy) return;
+    NativeCall call;
+    nativeStopPending = false;
+    const HRESULT hr = (nativeExiting || nativeFault || !Settings::NativeFfbEnabled || Settings::NativeFfbStrength <= 0)
+        ? nativeDevice.close() : nativeDevice.suspend();
+    if (nativeLastForce || shutdown)
+        spdlog::info("Native FFB contact trial: stop request shutdown={} lastCommand={} result=0x{:08X}; physical stop requires operator confirmation",
+            shutdown, nativeLastForce, unsigned(hr));
+    nativeLastForce = 0;
+    if (FAILED(hr))
+    {
+        // Foreground DirectInput auto-unacquires on focus loss. These two stop
+        // errors are expected; other cleanup failures disable further output.
+        if (hr != DIERR_NOTACQUIRED && hr != DIERR_INPUTLOST) NativeFail(hr);
+        spdlog::warn("Native FFB: stop/cleanup returned 0x{:08X}", unsigned(hr));
+    }
+}
+
+void NativeFfb_InputUpdated()
+{
+    if (NativeFfb_ProbeSession())
+    {
+        probeInputTick = GetTickCount64();
+        probeInputObserved = true;
+        CheckNativeProbe();
+        return;
+    }
+    if (!nativeArmed || nativeExiting) return;
+    auto* pad = InputManager::instance.getPrimaryGamepad();
+    nativeConnected = pad && SDL_GamepadConnected(pad) &&
+        SDL_GetGamepadVendor(pad) == nativeVendor && SDL_GetGamepadProduct(pad) == nativeProduct;
+    nativeSteer = nativeConnected ? SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTX) / 32768.0f : 0.0f;
+    nativeInputTick = GetTickCount64();
+    NativeFfb_Check();
+}
+
+void NativeFfb_Check()
+{
+    CheckNativeProbe(); // Also observes pause/menu transitions when the car hook is idle.
+    if (nativeArmed && !NativeAllowed(GetTickCount64())) NativeFfb_Stop();
+}
