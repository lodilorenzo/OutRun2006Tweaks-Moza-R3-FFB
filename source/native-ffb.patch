+struct Trace
+{
+    std::vector<std::string> calls;
+    std::string fail;
+    HRESULT failure = E_FAIL;
+    HRESULT hit(const char* name) { calls.emplace_back(name); return fail == name ? failure : S_OK; }
+    int count(const char* name) const { return int(std::count(calls.begin(), calls.end(), name)); }
+};
