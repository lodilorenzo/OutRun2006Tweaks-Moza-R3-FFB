+// P0 observation only. No driver, allocation, formatting or file I/O here.
+namespace Probe
+{
+constexpr size_t Capacity = 4096;
+constexpr uint64_t MaxDurationMs = 30000;
+enum class Stop : unsigned { None, Operator, Deadline, Full, Shutdown, Clock };
+struct Sample
+{
+    uint64_t tick = 0, timeUs = 0, inputTick = 0;
+    uint32_t player = 0, carId = 0, marker = 0;
+    int mode = -1, pauseMenu = -1;
+    bool focus = false, overlay = false, binding = false, connected = false, inputFresh = false;
+    float steer = 0;
+    int accel = 0, brake = 0;
+    uint32_t gear = 0, flags4 = 0, flags8 = 0;
+    // Raw offsets, deliberately not renamed as lateral motion/slip/crash state.
+    std::array<float, 7> raw{}; // 178, 1C4, 1D0, 1D4, 264, 268, 2F8
+    uint32_t raw281 = 0;
+    std::array<uint32_t, 4> surfaces{};
+    uint32_t stage = 0, loadType = 0;
+    int stageUnique = -1;
+    float roughness = -1;
+    uint32_t water = 0;
+    bool finite = false, surfaceValid = false;
+    uint64_t captureUs = 0;
+};
+struct Capture
+{
+    // ponytail: one <=30s capture per process; restart for another case. A crash
+    // loses the buffer; add recovery only after separately approved investigation.
+    std::array<Sample, Capacity> samples{};
+    size_t count = 0;
+    uint64_t startTick = 0, durationMs = 0;
+    Stop reason = Stop::None;
+    bool started = false;
+
+    bool running() const { return started && reason == Stop::None; }
+    bool start(uint64_t now, uint64_t duration)
+    {
+        if (started || duration < 1000 || duration > MaxDurationMs) return false;
+        startTick = now; durationMs = duration; started = true;
+        return true;
+    }
+    void stop(Stop why) { if (running() && why != Stop::None) reason = why; }
+    void poll(uint64_t now)
+    {
+        if (!running()) return;
+        if (now < startTick) stop(Stop::Clock);
+        else if (now - startTick >= durationMs) stop(Stop::Deadline);
+    }
+    bool push(const Sample& sample)
+    {
+        poll(sample.tick);
+        if (!running()) return false;
+        samples[count++] = sample;
+        if (count == Capacity) stop(Stop::Full); // No overwrite/wrap; capacity truncation explicit.
+        return true;
+    }
+    bool canFlush(bool inhibited, bool knownNonRacing) const
+    {
+        return started && !running() && inhibited && knownNonRacing;
+    }
+};
+
+// Stable numeric CSV, shared by the real flush path and synthetic/replay checks.
+// Called only AFTER stopping in a known non-racing state. No addresses/paths.
+inline void WriteCapture(std::ostream& out, const Capture& capture)
+{
+    out.imbue(std::locale::classic());
+    out << std::setprecision(9);
+    out << "# native-ffb-p0-v1 count=" << capture.count << " capacity=" << Capacity
+        << " stop=" << unsigned(capture.reason) << " start_tick=" << capture.startTick
+        << " duration_ms=" << capture.durationMs << " simulation_tick=unknown\n";
+    out << "seq,tick,time_us,input_tick,player,car_id,case,mode,pause_menu,focus,overlay,binding,pad,input_fresh,steer,accel,brake,gear,flags4,flags8,raw178,raw1C4,raw1D0,raw1D4,raw264,raw268,raw2F8,raw281,surface0,surface1,surface2,surface3,stage,load_type,stage_unique,roughness,water,finite,surface_valid,capture_us\n";
+    for (size_t i = 0; i < capture.count; ++i)
+    {
+        const auto& s = capture.samples[i];
+        out << i + 1 << ',' << s.tick << ',' << s.timeUs << ',' << s.inputTick << ',' << s.player
+            << ',' << s.carId << ',' << s.marker << ',' << s.mode << ',' << s.pauseMenu << ',' << s.focus
+            << ',' << s.overlay << ',' << s.binding << ',' << s.connected << ',' << s.inputFresh
+            << ',' << s.steer << ',' << s.accel << ',' << s.brake << ',' << s.gear << ',' << s.flags4 << ',' << s.flags8;
+        for (auto value : s.raw) out << ',' << value;
+        out << ',' << s.raw281;
+        for (auto mask : s.surfaces) out << ',' << mask;
+        out << ',' << s.stage << ',' << s.loadType << ',' << s.stageUnique << ',' << s.roughness
+            << ',' << s.water << ',' << s.finite << ',' << s.surfaceValid << ',' << s.captureUs << '\n';
+    }
+    out << "# end count=" << capture.count << '\n'; // Missing footer = incomplete write, not a passed capture.
+}
+}
