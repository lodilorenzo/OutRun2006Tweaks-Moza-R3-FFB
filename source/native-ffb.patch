+// Single game/window thread. QPC measures hook cadence, NOT simulation identity.
+static uint64_t ProbeMicroseconds(LARGE_INTEGER counter)
+{
+    if (probeFrequency.QuadPart <= 0 || counter.QuadPart < probeEpoch.QuadPart) return 0;
+    return uint64_t(double(counter.QuadPart - probeEpoch.QuadPart) * 1000000.0 / double(probeFrequency.QuadPart));
+}
+
+static void CheckNativeProbe()
+{
+    if (!probeSession || probeChecking) return;
+    probeChecking = true;
+    const auto now = GetTickCount64();
+    const int mode = Game::current_mode ? *Game::current_mode : -1;
+    const bool focus = Game::GameHwnd() && !IsIconic(Game::GameHwnd()) && GetForegroundWindow() == Game::GameHwnd();
+    const bool blocked = Overlay::IsActive || Overlay::IsBindingDialogActive || isListeningForInput != ListenState::False;
+    const bool control = focus && !blocked;
+    // Poll even out of focus so a held key cannot become a fresh press on regain.
+    const bool toggle = IsKeyPressed(VK_F5);
+    for (unsigned i = 0; i < 4; ++i)
+        if (IsKeyPressed(VK_F6 + int(i)) && control && mode == STATE_GAME) probeCase = i + 1;
+    if (toggle && control)
+    {
+        if (probeCapture.running()) probeCapture.stop(NativeFfb::Probe::Stop::Operator);
+        else if (mode == STATE_GAME && probeInputObserved && NativeFfb::Fresh(now, probeInputTick) && probeFrequency.QuadPart > 0)
+            probeCapture.start(now, probeDurationMs);
+    }
+    probeCapture.poll(now); // Deadline continues through pause/car-hook gaps.
+    if (mode != STATE_GAME) probePreviousCar = nullptr;
+    const bool knownNonRacing = mode >= STATE_SYSTEM && mode <= STATE_SUMOREWARD && mode != STATE_GAME;
+    if (!probeFlushAttempted && probeCapture.canFlush(NativeFfb_ProbeSession(), knownNonRacing))
+    {
+        probeFlushAttempted = true; // No repeated writes/stalls if the filesystem fails.
+        try
+        {
+            std::ostringstream text;
+            NativeFfb::Probe::WriteCapture(text, probeCapture);
+            const auto bytes = text.str();
+            const auto name = L"NativeFfb-P0-" + std::to_wstring(GetCurrentProcessId()) + L"-" + std::to_wstring(now) + L".csv";
+            const auto file = CreateFileW(name.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+            DWORD written = 0;
+            bool ok = false;
+            if (file != INVALID_HANDLE_VALUE)
+            {
+                ok = text.good() && bytes.size() <= MAXDWORD &&
+                    WriteFile(file, bytes.data(), DWORD(bytes.size()), &written, nullptr) && written == bytes.size();
+                if (!CloseHandle(file)) ok = false;
+            }
+            if (ok) spdlog::info("Native FFB P0: flushed {} samples, stop={}, capacity={}, file NativeFfb-P0-{}-{}.csv. "
+                "Markers are intent; capture completion is not runtime/signal validation.", probeCapture.count,
+                unsigned(probeCapture.reason), NativeFfb::Probe::Capacity, GetCurrentProcessId(), now);
+            else spdlog::error("Native FFB P0: capture write failed; no retry. Partial file must not be accepted.");
+        }
+        catch (...) { spdlog::error("Native FFB P0: capture serialization/write failed; no retry."); }
+    }
+    probeChecking = false;
+}
