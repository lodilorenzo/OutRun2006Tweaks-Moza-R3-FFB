+    Setting<bool> NativeRpmLedsDiagnostics{ "RPM LEDs", "NativeRpmLedsDiagnostics", false,
+        "Log dashboard RPM and requested LED mask once per second; not proof of physical output." };
+}
+
+namespace
+{
+    struct Shared
+    {
+        NativeRpmLeds::Mailbox mailbox;
+        std::atomic<DWORD> error{ERROR_SUCCESS};
+        std::atomic<unsigned> port{0};
+        std::atomic<bool> opened{false};
+        HANDLE stop = nullptr, thread = nullptr;
+        HWND hwnd = nullptr;
+    };
+    // ponytail: process-lifetime DLL, no unload API. Retain context if a broken
+    // serial driver ignores cancellation; never free memory still used by a worker.
+    Shared* state = nullptr;
+    bool initialized = false, exiting = false;
+    bool reportedOpen = false;
+    DWORD reportedError = ERROR_SUCCESS;
+    uint64_t inputTick = 0, logTick = 0;
+    int firstRpm = 4000, fullRpm = 8000;
+
+    struct Handle
+    {
+        HANDLE value = INVALID_HANDLE_VALUE;
+        ~Handle() { if (value != INVALID_HANDLE_VALUE && value) CloseHandle(value); }
+    };
+
+    // Fail closed if process enumeration fails. Never terminate Pit House or
+    // SimHub, nor try to share/steal their serial connection.
+    bool CompanionRunning()
+    {
+        Handle snapshot{CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0)};
+        if (snapshot.value == INVALID_HANDLE_VALUE) return true;
+        PROCESSENTRY32W entry{};
+        entry.dwSize = sizeof(entry);
+        if (!Process32FirstW(snapshot.value, &entry)) return true;
+        do
+        {
+            if (!_wcsicmp(entry.szExeFile, L"MOZA Pit House.exe") || !_wcsicmp(entry.szExeFile, L"SimHub.exe")) return true;
+        } while (Process32NextW(snapshot.value, &entry));
+        return GetLastError() != ERROR_NO_MORE_FILES;
+    }
+
+    // Enumerate only present Ports-class R3 MI_00 interfaces. Never guess COM4,
+    // fall back to another serial device, or resolve an ambiguous pair of R3s.
+    unsigned FindPort()
+    {
+        constexpr GUID portsClass{0x4d36e978, 0xe325, 0x11ce, {0xbf, 0xc1, 0x08, 0x00, 0x2b, 0xe1, 0x03, 0x18}};
+        const auto info = SetupDiGetClassDevsW(&portsClass, nullptr, nullptr, DIGCF_PRESENT);
+        if (info == INVALID_HANDLE_VALUE) return 0;
+        const std::unique_ptr<void, decltype(&SetupDiDestroyDeviceInfoList)> cleanup(info, SetupDiDestroyDeviceInfoList);
+        unsigned found = 0, matches = 0;
+        SP_DEVINFO_DATA device{};
+        device.cbSize = sizeof(device);
+        for (DWORD i = 0; ; ++i)
+        {
+            if (!SetupDiEnumDeviceInfo(info, i, &device))
+                return GetLastError() == ERROR_NO_MORE_ITEMS && matches == 1 ? found : 0;
+            wchar_t id[512]{};
+            if (!SetupDiGetDeviceInstanceIdW(info, &device, id, DWORD(std::size(id)), nullptr)) return 0;
+            constexpr wchar_t prefix[] = L"USB\\VID_346E&PID_0005&MI_00\\";
+            if (_wcsnicmp(id, prefix, std::size(prefix) - 1)) continue;
+            if (++matches != 1) return 0;
+            HKEY key = SetupDiOpenDevRegKey(info, &device, DICS_FLAG_GLOBAL, 0, DIREG_DEV, KEY_QUERY_VALUE);
+            if (key == INVALID_HANDLE_VALUE) return 0;
+            wchar_t name[32]{};
+            DWORD bytes = sizeof(name);
+            const auto result = RegGetValueW(key, nullptr, L"PortName", RRF_RT_REG_SZ, nullptr, name, &bytes);
+            RegCloseKey(key);
+            if (result != ERROR_SUCCESS || wcsncmp(name, L"COM", 3)) return 0;
+            wchar_t* end = nullptr;
+            const auto number = wcstoul(name + 3, &end, 10);
+            if (end == name + 3 || *end || number == 0 || number > 65535) return 0;
+            found = unsigned(number);
+        }
+    }
+
+    DWORD Send(HANDLE serial, uint16_t mask)
+    {
+        const auto frame = NativeRpmLeds::Encode(mask);
+        DWORD sent = 0;
+        if (!WriteFile(serial, frame.bytes.data(), frame.size, &sent, nullptr)) return GetLastError();
+        return sent == frame.size ? ERROR_SUCCESS : ERROR_WRITE_FAULT;
+    }
+
+    unsigned __stdcall Worker(void* parameter)
+    {
+        auto& s = *static_cast<Shared*>(parameter);
+        try
+        {
+            if (CompanionRunning()) { s.error = ERROR_BUSY; return 0; }
+            const auto port = FindPort();
+            if (!port) { s.error = ERROR_NOT_FOUND; return 0; }
+            if (WaitForSingleObject(s.stop, 0) != WAIT_TIMEOUT) return 0;
+            const auto path = L"\\\\.\\COM" + std::to_wstring(port);
+            Handle serial{CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, 0, nullptr)};
+            if (serial.value == INVALID_HANDLE_VALUE) { s.error = GetLastError(); return 0; }
+            DCB dcb{};
+            dcb.DCBlength = sizeof(dcb);
+            if (!BuildCommDCBW(L"baud=115200 parity=N data=8 stop=1 dtr=off rts=off octs=off odsr=off xon=off", &dcb) ||
+                !SetCommState(serial.value, &dcb)) { s.error = GetLastError(); return 0; }
+            COMMTIMEOUTS timeouts{};
+            timeouts.WriteTotalTimeoutConstant = 100;
+            if (!SetCommTimeouts(serial.value, &timeouts)) { s.error = GetLastError(); return 0; }
+            s.port = port;
+            s.opened = true;
+            // All serial operations are on this worker, never the game/FFB thread.
+            // A stale publisher clears after 250ms even if the game thread hangs.
+            while (WaitForSingleObject(s.stop, 0) == WAIT_TIMEOUT)
+            {
+                const bool foreground = GetForegroundWindow() == s.hwnd && !IsIconic(s.hwnd);
+                const auto mask = s.mailbox.read(GetTickCount64(), foreground);
+                const auto error = Send(serial.value, mask);
+                if (error != ERROR_SUCCESS) { s.error = error; break; }
+                if (WaitForSingleObject(s.stop, 33) != WAIT_TIMEOUT) break;
+            }
+            // Best effort only: driver/device failure can prevent zero reaching
+            // the LEDs. No retries of nonzero output, no automatic reconnect.
+            for (int i = 0; i < 3; ++i)
+            {
+                const auto error = Send(serial.value, 0);
+                if (error != ERROR_SUCCESS) { s.error = error; break; }
+                Sleep(10);
+            }
+            s.opened = false;
+        }
+        catch (...) { s.error = ERROR_UNHANDLED_EXCEPTION; }
+        return 0;
+    }
+
+    bool Allowed()
+    {
+        return state && !exiting && Settings::NativeRpmLedsEnabled && Settings::UseNewInput &&
+            NativeRpmLeds::Fresh(GetTickCount64(), inputTick) && Game::current_mode && *Game::current_mode == STATE_GAME &&
+            GetForegroundWindow() == state->hwnd && !IsIconic(state->hwnd) &&
+            !Overlay::IsActive && !Overlay::IsBindingDialogActive && isListeningForInput == ListenState::False;
+    }
+}
+
+static void NativeRpmLeds_Init()
+{
+    if (initialized || exiting) return;
+    initialized = true;
+    if (!Settings::NativeRpmLedsEnabled || NativeFfb_ProbeSession()) return; // P0 must not start a worker/open serial.
+    firstRpm = Settings::NativeRpmLedsFirstRpm;
+    fullRpm = Settings::NativeRpmLedsFullRpm;
+    if (!NativeRpmLeds::ValidRange(firstRpm, fullRpm) || !Game::GameHwnd())
+    {
+        spdlog::error("Native RPM LEDs: invalid RPM range/window; disabled for this session");
+        return;
+    }
+    try
+    {
+        state = new Shared;
+        state->hwnd = Game::GameHwnd();
+        state->stop = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        if (!state->stop) { state->error = GetLastError(); return; }
+        state->thread = reinterpret_cast<HANDLE>(_beginthreadex(nullptr, 0, Worker, state, 0, nullptr));
+        if (!state->thread)
+        {
+            state->error = ERROR_NOT_ENOUGH_MEMORY;
+            CloseHandle(state->stop);
+            state->stop = nullptr;
+        }
+        else spdlog::info("Native RPM LEDs: starting R3/ES worker; first={} full={}; Pit House must remain closed", firstRpm, fullRpm);
+    }
+    catch (...) { spdlog::error("Native RPM LEDs: startup failed; input and FFB unchanged"); }
+}
+
+void NativeRpmLeds_InputUpdated()
+{
+    // First real input tick: the game window is fully initialized by now.
+    if (!initialized && !exiting) NativeRpmLeds_Init();
+    if (!state || exiting) return;
+    auto* pad = InputManager::instance.getPrimaryGamepad();
+    const bool connected = pad && SDL_GamepadConnected(pad) && SDL_GetGamepadVendor(pad) == 0x346e && SDL_GetGamepadProduct(pad) == 5;
+    inputTick = connected ? GetTickCount64() : 0;
+    NativeRpmLeds_Check();
+}
+
+void NativeRpmLeds_Update(EVWORK_CAR* car)
+{
+    if (!state || exiting) return;
+    if (!Allowed()) { state->mailbox.clear(); return; }
+    if (!car || car != Game::pl_car()) return;
+    static_assert(offsetof(EVWORK_CAR, dword20C) == 0x20c);
+    const auto rpm = car->dword20C; // Actual smoothed dashboard RPM, not speed/gear synthesis.
+    const auto now = GetTickCount64();
+    const auto mask = NativeRpmLeds::Mask(rpm, firstRpm, fullRpm);
+    state->mailbox.publish(mask, now);
+    if (Settings::NativeRpmLedsDiagnostics && now - logTick >= 1000)
+    {
+        logTick = now;
+        spdlog::info("Native RPM LEDs: dashboardRPM={} requestedMask=0x{:03X}", rpm, mask);
+    }
+}
+
+void NativeRpmLeds_Check()
+{
+    if (!state || exiting) return;
+    if (!Allowed()) state->mailbox.clear();
+    if (state->opened.load() && !reportedOpen)
+    {
+        reportedOpen = true;
+        spdlog::info("Native RPM LEDs: exclusive COM{} opened; legacy LED-only output", state->port.load());
+    }
+    const auto error = state->error.load();
+    if (error != ERROR_SUCCESS && error != reportedError)
+    {
+        reportedError = error;
+        spdlog::error("Native RPM LEDs: disabled until restart, Win32 error={} (170: close Pit House/SimHub; 1168: no unique R3 port). Input/FFB unchanged", error);
+    }
+}
+
+void NativeRpmLeds_Stop(bool shutdown)
+{
+    if (state) state->mailbox.clear();
+    inputTick = 0;
+    if (!shutdown || exiting) return;
+    exiting = true;
+    if (!state || !state->thread) return;
+    SetEvent(state->stop);
+    if (WaitForSingleObject(state->thread, 1000) == WAIT_OBJECT_0)
+    {
+        CloseHandle(state->thread); state->thread = nullptr;
+        CloseHandle(state->stop); state->stop = nullptr;
+        spdlog::info("Native RPM LEDs: worker stopped, final clearing attempted; error={}", state->error.load());
+    }
+    else
+    {
+        CancelSynchronousIo(state->thread);
+        spdlog::warn("Native RPM LEDs: driver did not stop within 1s; cancellation requested, context retained until process exit");
+    }
+}
+
+class NativeRpmLedSettings : public Hook
+{
+public:
+    std::string_view description() override { return "Native RPM LEDs"; }
+    void declare_settings() override
+    {
+        Settings::NativeRpmLedsEnabled.needs_restart();
+        Settings::NativeRpmLedsFirstRpm.needs_restart();
+        Settings::NativeRpmLedsFullRpm.needs_restart();
+    }
+    bool validate() override { return false; } // Settings only; reuse existing hooks.
+    bool apply() override { return true; }
+    static NativeRpmLedSettings instance;
+};
+NativeRpmLedSettings NativeRpmLedSettings::instance;
diff --git a/src/native_rpm_leds.hpp b/src/native_rpm_leds.hpp
new file mode 100644
index 0000000..d455d99
--- /dev/null
+++ b/src/native_rpm_leds.hpp
@@ -0,0 +1,83 @@
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+
+// R3 + ES only. Legacy runtime LED frames, not wheel configuration commands.
+// Protocol reference: francisdb/moza-rev, 6a3cf66c734dde29126e6d9b296adeab4479d005.
+// Independently encoded from the wire format; validated by the local LED-only test.
+namespace NativeRpmLeds
+{
+    constexpr uint64_t StaleMs = 250;
+    constexpr uint32_t MaxRpm = 20000;
+    constexpr uint16_t FullMask = 1023;
+
+    inline bool ValidRange(int first, int full)
+    {
+        return first >= 100 && first < full && full <= int(MaxRpm);
+    }
+
+    inline uint16_t Mask(uint32_t rpm, int first, int full)
+    {
+        if (!ValidRange(first, full) || rpm > MaxRpm || rpm < uint32_t(first)) return 0;
+        if (rpm >= uint32_t(full)) return FullMask;
+        const auto count = 1 + (rpm - uint32_t(first)) * 9 / uint32_t(full - first);
+        return uint16_t((1u << count) - 1);
+    }
+
+    struct Frame
+    {
+        std::array<uint8_t, 20> bytes{};
+        uint32_t size = 0;
+    };
+
+    inline Frame Encode(uint16_t mask)
+    {
+        if (mask > FullMask) throw std::invalid_argument("R3 LED mask outside 0..1023");
+        Frame frame;
+        frame.bytes[frame.size++] = 0x7e;
+        frame.bytes[frame.size++] = 6;
+        unsigned checksum = 0x0d + 0x7e + 6;
+        const uint8_t body[] = { 0x41, 0x13, 0xfd, 0xde, 0, 0, uint8_t(mask >> 8), uint8_t(mask) };
+        for (const auto b : body)
+        {
+            frame.bytes[frame.size++] = b;
+            checksum += b;
+            if (b == 0x7e) { frame.bytes[frame.size++] = b; checksum += b; }
+        }
+        const auto b = uint8_t(checksum);
+        frame.bytes[frame.size++] = b;
+        if (b == 0x7e) frame.bytes[frame.size++] = b;
+        return frame;
+    }
+
+    inline bool Fresh(uint64_t now, uint64_t then)
+    {
+        return then != 0 && now >= then && now - then < StaleMs;
+    }
+
+    // One atomic snapshot: no torn timestamp/mask on Win32. Worker never reads
+    // game memory or mutable settings. Zero invalidates the previous sample.
+    struct Mailbox
+    {
+        std::atomic<uint64_t> sample{0};
+        void clear() { sample.store(0); }
+        void publish(uint16_t mask, uint64_t now)
+        {
+            sample.store(mask <= FullMask && now < (uint64_t{1} << 48) ? (now << 16) | mask : 0);
+        }
+        uint16_t read(uint64_t now, bool foreground) const
+        {
+            const auto value = sample.load();
+            return foreground && Fresh(now, value >> 16) ? uint16_t(value & FullMask) : 0;
+        }
+    };
+}
+
+struct tagEVWORK_CAR;
+void NativeRpmLeds_InputUpdated();
+void NativeRpmLeds_Update(tagEVWORK_CAR* car);
+void NativeRpmLeds_Check();
+void NativeRpmLeds_Stop(bool shutdown = false);
