+    const int mode = Game::current_mode ? *Game::current_mode : -1;
+    const bool focus = Game::GameHwnd() && GetForegroundWindow() == Game::GameHwnd();
+    const int accel = connected ? SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) : 0;
+    const int brake = connected ? SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFT_TRIGGER) : 0;
+    if (Settings::NativeFfbDiagnostics && now - lastLog >= 500)
+    {
+        lastLog = now;
